# Feature: a generic struct whose field is ANOTHER generic struct (M4). `Wrapper[T]`
# embeds `Box[T]`; reifying `Wrapper[int]` recurses into `Box[int]` for the field.
# Regression guard: the wrapper is declared BEFORE the inner struct, so the wrapper's
# reified `struct_id` slot must be claimed before the field recursion runs — otherwise
# the inner struct steals it and codegen mis-locates the field.
# expect: exit 41
struct Wrapper[T] { b: Box[T] }
struct Box[T] { v: T }
fn main() -> int {
  w := Wrapper[int]{ b: Box[int]{ v: 41 } }
  return w.b.v
}
