# Feature: conflicting field-value inference at a generic-struct constructor (T0015).
# `Pair[T]{ a: T, b: T }` binds `T` from BOTH fields; `Pair{ a: 1, b: true }` matches T
# against int (field `a`) then bool (field `b`) — inference cannot pick one, so the
# construction is rejected with T0015 naming both field spans. Explicit `Pair[int]{..}`
# would override.
# expect: compile-error "T0015"
struct Pair[T] { a: T, b: T }
fn main() -> int {
  _p := Pair{ a: 1, b: true }
  return 0
}
