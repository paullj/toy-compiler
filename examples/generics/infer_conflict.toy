# Feature: conflicting type-arg inference is a hard error (T0015).
# `same[T](a: T, b: T)` binds T from BOTH args; `same(1, true)` matches T against
# int (arg 1) then bool (arg 2) — inference cannot pick one, so the call is rejected
# with T0015 naming both argument spans. Explicit `same[int](1, 1)` would override.
# expect: compile-error "T0015"
fn same[T](a: T, _b: T) -> T { a }
fn main() -> int { return same(1, true) }
