# Feature: `break` and `continue` in a `while` loop.
# expect: exit 13
# Advance i first; `continue` skips the add when i == 2; `break` stops at i == 6.
# Adds 1 + 3 + 4 + 5 = 13 (2 is skipped, 6 breaks before adding).
fn main() -> int {
  i := 0
  s := 0
  while i < 100 {
    i = i + 1
    if i == 2 { continue }
    if i == 6 { break }
    s = s + i
  }
  return s
}
