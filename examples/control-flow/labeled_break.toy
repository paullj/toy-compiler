# Feature: break a VALUE out of an OUTER loop from inside an inner loop.
# expect: exit 40
# Scans j in 0..10; on j == 4, `break @outer j * 10` exits BOTH loops, and the
# outer `loop` expression yields 40.
fn main() -> int {
    @outer loop {
        for j in 0..10 {
            if j == 4 {
                break @outer j * 10
            }
        }
    }
}
