# Feature: tuple-field STORES `p.0 = v` (R6), including a nested `o.0.0 = v` chain —
# routed through the record field-store machinery over the numeric field names.
# expect: exit 44
struct Pair(int, int)
struct Inner(int)
struct Outer(Inner)

fn main() -> int {
    p := Pair(1, 2)
    p.0 = 40
    o := Outer(Inner(0))
    o.0.0 = 2
    return p.0 + p.1 + o.0.0                  # 40 + 2 + 2
}
