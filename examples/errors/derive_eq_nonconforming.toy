# Feature (negative): structural `Eq` derive fires only when EVERY field conforms (M18).
# `Color` carries a payload variant, so it does NOT conform to `Eq` (payload-enum Eq is
# deferred to M19). Comparing a `Bad` with `==` therefore cannot derive, and the error
# names the offending field + its type + the protocol (T0029). The fix: an explicit
# `impl Color has Eq { .. }`, or an explicit `impl Bad has Eq { .. }`.
enum Color { R(int), G, B }
struct Bad { c: Color }

fn main() -> int {
    a := Bad{ c: Color.G }
    b := Bad{ c: Color.G }
    return if a == b { 1 } else { 0 }
}
# expect: compile-error "field 'c'"
