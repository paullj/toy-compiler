# Feature (negative): `==`/`!=` desugar to `Eq::eq`. A type that provably does not
# conform to `Eq` is a compile-error at the operator (T0026). Now EVERY ground value
# type conforms structurally (a struct/enum derives `Eq` on demand — see
# examples/derive/eq_payload_enum.toy), so the ONLY still-reachable T0026 is a generic body
# whose type parameter is bounded by a protocol that is NOT `Eq`: the bound is the only axiom
# in scope, so `a == b` cannot desugar. The fix: bound `T` by `Eq`.
protocol Doubler { fn dbl(self) -> int }

fn bad[T has Doubler](a: T, b: T) -> bool { a == b }

fn main() -> int {
    return 0
}
# expect: compile-error "T0026"
