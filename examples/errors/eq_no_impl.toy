# Feature (negative): `==`/`!=` desugar to `Eq::eq` (M15). A struct with NO `Eq` impl
# used with `==` is a compile-error AT THE OPERATOR (T0026) — the fix is an
# `impl P has Eq { fn eq(self, o: P) -> bool { .. } }` (an auto-derive lands in M18).
# expect: compile-error "T0026"
struct P { x: int }

fn main() -> int {
    p := P{ x: 1 }
    q := P{ x: 2 }
    return if p == q { 1 } else { 0 }
}
