# Feature (negative): `==`/`!=` desugar to `Eq::eq` (M15). A type with NO `Eq` impl that
# ALSO cannot be structurally auto-derived (M18) is a compile-error at the operator
# (T0026). A payload-carrying enum does NOT structurally conform to `Eq` in M18 (its Eq
# derive is deferred to M19), so comparing one with no impl still needs an explicit
# `impl E has Eq { fn eq(self, o: E) -> bool { .. } }`. (An all-Eq-fields STRUCT, by
# contrast, now derives `Eq` for free — see examples/derive/eq.toy.)
# expect: compile-error "T0026"
enum E { A(int), B }

fn main() -> int {
    p := E.B
    q := E.B
    return if p == q { 1 } else { 0 }
}
