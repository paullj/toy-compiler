# Feature (negative): `for x in <expr>` requires the receiver to be iterable — have an
# inherent `iter()` returning a type that conforms to `Iterator[Item]`. An `int` receiver
# has neither, so the loop is a compile error naming the `Iterator` protocol.
# expect: compile-error "Iterator"
fn main() -> int {
    for _ in 5 {
    }
    return 0
}
