# Feature: a GENERIC protocol `Into[U]` (type-params replace associated types, M14). One
# type `P` conforms TWICE with different args (`Into[int]` and `Into[bool]`) — the new
# multi-conformance capability. A bounded generic `use[T has Into[int]]` dispatches
# `v.into[int]()` with explicit protocol type-args, selecting the `Into[int]` witness
# (self.x == 42). The two conformances are keyed on (protocol, type, protocol-args), so
# they do NOT collide on coherence (T0020).
# expect: exit 42
protocol Into[U] {
    fn into(self) -> U
}

struct P { x: int }

impl P has Into[int] {
    fn into(self) -> int { self.x }
}

impl P has Into[bool] {
    fn into(self) -> bool { self.x > 0 }
}

fn use[T has Into[int]](v: T) -> int { v.into[int]() }

fn main() -> int {
    return use(P{ x: 42 })
}
