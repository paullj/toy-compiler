# Feature: structural `Ord` derive on a PAYLOAD enum (M19). Order is DISCRIMINANT (case
# declaration) order first, then payload lexicographically — the SE-0266 total order. So
# `Z < S(_)` (case 0 before case 1) and `S(1) < S(2)` (equal tag, payload decides). The
# derived `cmp` also fills `Eq`, so `==` works via it. Exercises the discriminant-then-payload
# walk and closes the M18 payload-enum gap in one type.
enum N { Z, S(int) }

fn main() -> int {
    r := 0
    if N.Z < N.S(0) { r = r + 1 }          # tag 0 < tag 1
    if N.S(1) < N.S(2) { r = r + 2 }        # equal tag -> payload 1 < 2
    if N.S(2) > N.S(1) { r = r + 4 }        # symmetric
    if N.S(3) == N.S(3) { r = r + 8 }       # `==` via the derived cmp (Ord fills Eq)
    if N.Z != N.S(0) { r = r + 27 }         # differing tags are not equal
    return r
}
# expect: exit 42
