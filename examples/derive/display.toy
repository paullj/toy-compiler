# Feature: structural `Display` derive. `io.print` accepts ANY value whose type
# conforms to the prelude `Display` protocol; a struct with all-Display fields derives it
# structurally (no impl, no `derive` keyword). `display()` renders to a `str`: the struct
# name + `{`, each `field: <value>` (`, `-separated), then `}`. The int fields render via the
# never-negate `__int_to_str`.
import std/io
struct P { x: int, y: int }

fn main() {
    io.print(P{ x: 4, y: 2 })
}
# expect: stdout "P{x: 4, y: 2}"
# expect: exit 0
