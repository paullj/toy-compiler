# Feature: structural `Display` derive (M22). `print` accepts ANY value whose type
# conforms to the prelude `Display` protocol; a struct with all-Display fields derives it
# structurally (no impl, no `derive` keyword). `display()` WRITES directly to stdout via the
# libSystem `write` path — never a returned `str`, so it touches no allocator: the struct
# name + `{`, each `field: <value>` (`, `-separated), then `}`. The int fields render via a
# heap-free stack-buffer decimal renderer (`__display_int`).
struct P { x: int, y: int }

fn main() {
    print(P{ x: 4, y: 2 })
}
# expect: stdout "P{x: 4, y: 2}"
# expect: exit 0
