# Feature: an explicit `impl has Eq` OVERRIDES the structural derive. This impl
# calls two `P`s equal regardless of their fields, so `a == b` (with x differing) returns
# TRUE and the program exits 42. A structural derive would compare `x` and return 0 — so
# exit 42 proves the user witness won (the derive never fired; no synthetic unit emitted).
struct P { x: int }

impl P has Eq {
    fn eq(self, _o: P) -> bool { true }
}

fn main() -> int {
    a := P{ x: 1 }
    b := P{ x: 2 }
    return if a == b { 42 } else { 0 }
}
# expect: exit 42
