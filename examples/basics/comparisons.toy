# Feature: comparison operators yield bool; a bare `return` from a unit function.
# expect: exit 0
# `==` and `>` produce bool locals; main has no `-> int`, so its bare `return`
# leaves the exit code at 0.
fn add(a: int, b: int) -> int {
    return a + b
}

fn neg(x: int) -> int {
    return -x
}

fn main() {
    x := add(1, 2)
    y := neg(x)
    ok := x == 3
    z := x > y
    return
}
