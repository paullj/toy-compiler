# Feature: sized integer types (`int8`/`uint8`), homogeneous-width arithmetic result
# type, base-16 literals, and per-width Ord conformance (M1).
# expect: exit 42
# a=100, b=20, c=a+b=120 (all int8); h=0x2A=42, g=0x0A=10 (uint8). Every comparison is
# true, so the value-`if` yields 42. `c: int8 = a + b` exercises the homogeneous-width
# result type; `a > b`/`h > g` exercise int8/uint8 Ord; `0x2A` the base-16 literal form.
fn main() -> int {
    a: int8  = 100
    b: int8  = 20
    c: int8  = a + b
    h: uint8 = 0x2A
    g: uint8 = 0x0A
    return if a > b && c > b && h > g { 42 } else { 0 }
}
