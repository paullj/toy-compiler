# Feature: two instances of one generic impl monomorphize to DISTINCT units, and an
# uncalled generic method emits ZERO codegen.
# expect: exit 42
# `Box[int].get()` and `Box[Point].get()` are distinct concrete units (return int vs
# Point). `sum(self)` is defined but NEVER called on any instance, so it monomorphizes
# to nothing. 40 (from bi.get()) + 2 (from bp.get().x) = 42.
struct Point { x: int, y: int }

struct Box[T] { v: T }

impl Box[T] {
    fn get(self) -> T { self.v }
    fn same(self) -> Box[T] { self }
}

fn main() -> int {
    bi := Box[int]{ v: 40 }
    bp := Box[Point]{ v: Point{ x: 2, y: 9 } }
    p := bp.get()
    return bi.get() + p.x
}
