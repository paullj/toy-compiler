# Feature: `to_string` is UNIVERSAL — a type with an explicit `impl Display` has it too,
# returning that impl's str (no derive, no T0031). The result round-trips through `==` and
# `.concat`, proving it is an ordinary str value, not a write side effect.
struct Money { cents: int }

impl Money has Display {
    fn display(self) -> str {
        return "$".concat(self.cents.to_string())
    }
}

fn main() -> int {
    m := Money{ cents: 42 }
    s := m.to_string()
    if s == "$42" {
        print(s.concat("!"))
    } else {
        print("MISMATCH")
    }
    return 0
}
# expect: stdout "$42!"
# expect: exit 0
