import mod_43
struct S_44 { a: int, b: int }
enum E_44 { Lo, Hi(int) }
fn f_44_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_43.entry(n)
}
fn f_44_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_44_0(n)
}
