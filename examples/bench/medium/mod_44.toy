fn f_44_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_44_10(n)
}
fn tag_44(e: E_44) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_44 { a: n, b: 44 }
    return f_44_11(s.a) + tag_44(E_44.Hi(s.b))
}
