fn f_50_10(n: int) -> int {
    acc := n + 10
    for j in 0..4 {
        acc = acc + j * 10
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_50_9(n)
}
fn f_50_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_50_10(n)
}
fn tag_50(e: E_50) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_50 { a: n, b: 50 }
    return f_50_11(s.a) + tag_50(E_50.Hi(s.b))
}
