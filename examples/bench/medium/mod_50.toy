import mod_49
struct S_50 { a: int, b: int }
enum E_50 { Lo, Hi(int) }
fn f_50_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_49.entry(n)
}
fn f_50_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_50_0(n)
}
