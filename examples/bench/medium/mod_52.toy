import mod_51
struct S_52 { a: int, b: int }
enum E_52 { Lo, Hi(int) }
fn f_52_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_51.entry(n)
}
fn f_52_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_52_0(n)
}
