fn f_52_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_52_10(n)
}
fn tag_52(e: E_52) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_52 { a: n, b: 52 }
    return f_52_11(s.a) + tag_52(E_52.Hi(s.b))
}
