import mod_85
struct S_86 { a: int, b: int }
enum E_86 { Lo, Hi(int) }
fn f_86_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_85.entry(n)
}
fn f_86_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_86_0(n)
}
