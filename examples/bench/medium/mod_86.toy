fn f_86_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_86_10(n)
}
fn tag_86(e: E_86) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_86 { a: n, b: 86 }
    return f_86_11(s.a) + tag_86(E_86.Hi(s.b))
}
