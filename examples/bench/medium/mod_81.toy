import mod_80
struct S_81 { a: int, b: int }
enum E_81 { Lo, Hi(int) }
fn f_81_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_80.entry(n)
}
