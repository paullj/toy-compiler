import mod_56
struct S_57 { a: int, b: int }
enum E_57 { Lo, Hi(int) }
fn f_57_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_56.entry(n)
}
fn f_57_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_57_0(n)
}
