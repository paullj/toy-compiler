fn tag_57(e: E_57) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_57 { a: n, b: 57 }
    return f_57_11(s.a) + tag_57(E_57.Hi(s.b))
}
