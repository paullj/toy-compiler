import mod_83
struct S_84 { a: int, b: int }
enum E_84 { Lo, Hi(int) }
fn f_84_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_83.entry(n)
}
fn f_84_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_84_0(n)
}
