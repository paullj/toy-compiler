fn f_84_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_84_10(n)
}
fn tag_84(e: E_84) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_84 { a: n, b: 84 }
    return f_84_11(s.a) + tag_84(E_84.Hi(s.b))
}
