fn f_66_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_66_10(n)
}
fn tag_66(e: E_66) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_66 { a: n, b: 66 }
    return f_66_11(s.a) + tag_66(E_66.Hi(s.b))
}
