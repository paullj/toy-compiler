import mod_65
struct S_66 { a: int, b: int }
enum E_66 { Lo, Hi(int) }
fn f_66_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_65.entry(n)
}
fn f_66_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_66_0(n)
}
