# bench/medium — a Shape enum with payloads + match, built on the vec module.
import geom/vec

pub enum Shape { Dot, Circle(int), Rect { w: int, h: int } }

pub fn circle(r: int) -> Shape { Shape.Circle(r) }

pub fn rect(w: int, h: int) -> Shape { Shape.Rect { w: w, h: h } }

pub fn area(s: Shape) -> int {
    match s {
        .Dot -> 0,
        .Circle(r) -> 3 * r * r,
        .Rect { w, h } -> w * h
    }
}

pub fn bbox(s: Shape) -> vec.Vec {
    match s {
        .Dot -> vec.new(0, 0),
        .Circle(r) -> vec.new(2 * r, 2 * r),
        .Rect { w, h } -> vec.new(w, h)
    }
}
