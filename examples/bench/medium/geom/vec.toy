# bench/medium — a 2D integer vector module (struct + by-value ops).
pub struct Vec { x: int, y: int }

pub fn new(x: int, y: int) -> Vec { Vec { x: x, y: y } }

pub fn add(a: Vec, b: Vec) -> Vec { Vec { x: a.x + b.x, y: a.y + b.y } }

pub fn sub(a: Vec, b: Vec) -> Vec { Vec { x: a.x - b.x, y: a.y - b.y } }

pub fn dot(a: Vec, b: Vec) -> int { a.x * b.x + a.y * b.y }

pub fn scale(v: Vec, k: int) -> Vec { Vec { x: v.x * k, y: v.y * k } }
