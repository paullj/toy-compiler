fn tag_79(e: E_79) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_79 { a: n, b: 79 }
    return f_79_11(s.a) + tag_79(E_79.Hi(s.b))
}
