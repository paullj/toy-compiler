import mod_78
struct S_79 { a: int, b: int }
enum E_79 { Lo, Hi(int) }
fn f_79_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_78.entry(n)
}
fn f_79_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_79_0(n)
}
