import mod_64
struct S_65 { a: int, b: int }
enum E_65 { Lo, Hi(int) }
fn f_65_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_64.entry(n)
}
fn f_65_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_65_0(n)
}
