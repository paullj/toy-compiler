fn f_65_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_65_10(n)
}
fn tag_65(e: E_65) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_65 { a: n, b: 65 }
    return f_65_11(s.a) + tag_65(E_65.Hi(s.b))
}
