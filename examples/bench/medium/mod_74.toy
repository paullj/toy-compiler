import mod_73
struct S_74 { a: int, b: int }
enum E_74 { Lo, Hi(int) }
fn f_74_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_73.entry(n)
}
fn f_74_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_74_0(n)
}
