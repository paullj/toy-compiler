fn f_74_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_74_10(n)
}
fn tag_74(e: E_74) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_74 { a: n, b: 74 }
    return f_74_11(s.a) + tag_74(E_74.Hi(s.b))
}
