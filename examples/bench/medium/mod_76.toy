fn tag_76(e: E_76) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_76 { a: n, b: 76 }
    return f_76_11(s.a) + tag_76(E_76.Hi(s.b))
}
