import mod_75
struct S_76 { a: int, b: int }
enum E_76 { Lo, Hi(int) }
fn f_76_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_75.entry(n)
}
