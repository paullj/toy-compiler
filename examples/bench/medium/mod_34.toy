fn f_34_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_34_10(n)
}
fn tag_34(e: E_34) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_34 { a: n, b: 34 }
    return f_34_11(s.a) + tag_34(E_34.Hi(s.b))
}
