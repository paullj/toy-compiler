import mod_33
struct S_34 { a: int, b: int }
enum E_34 { Lo, Hi(int) }
fn f_34_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_33.entry(n)
}
fn f_34_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_34_0(n)
}
