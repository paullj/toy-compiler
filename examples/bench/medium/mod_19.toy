fn tag_19(e: E_19) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_19 { a: n, b: 19 }
    return f_19_11(s.a) + tag_19(E_19.Hi(s.b))
}
