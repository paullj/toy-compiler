import mod_18
struct S_19 { a: int, b: int }
enum E_19 { Lo, Hi(int) }
fn f_19_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_18.entry(n)
}
fn f_19_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_19_0(n)
}
