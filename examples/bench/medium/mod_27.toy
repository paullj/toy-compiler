fn tag_27(e: E_27) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_27 { a: n, b: 27 }
    return f_27_11(s.a) + tag_27(E_27.Hi(s.b))
}
