import mod_26
struct S_27 { a: int, b: int }
enum E_27 { Lo, Hi(int) }
fn f_27_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_26.entry(n)
}
