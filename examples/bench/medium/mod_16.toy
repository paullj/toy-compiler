import mod_15
struct S_16 { a: int, b: int }
enum E_16 { Lo, Hi(int) }
fn f_16_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_15.entry(n)
}
fn f_16_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_16_0(n)
}
