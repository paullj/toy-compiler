fn f_16_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_16_10(n)
}
fn tag_16(e: E_16) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_16 { a: n, b: 16 }
    return f_16_11(s.a) + tag_16(E_16.Hi(s.b))
}
