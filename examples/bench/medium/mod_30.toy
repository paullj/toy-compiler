fn f_30_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_30_10(n)
}
fn tag_30(e: E_30) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_30 { a: n, b: 30 }
    return f_30_11(s.a) + tag_30(E_30.Hi(s.b))
}
