import mod_29
struct S_30 { a: int, b: int }
enum E_30 { Lo, Hi(int) }
fn f_30_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_29.entry(n)
}
fn f_30_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_30_0(n)
}
