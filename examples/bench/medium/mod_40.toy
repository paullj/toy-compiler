    acc := n + 3
    for j in 0..4 {
        acc = acc + j * 3
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_40_2(n)
}
fn f_40_4(n: int) -> int {
    acc := n + 4
    for j in 0..4 {
        acc = acc + j * 4
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_40_3(n)
}
fn f_40_5(n: int) -> int {
    acc := n + 5
    for j in 0..4 {
        acc = acc + j * 5
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_40_4(n)
}
