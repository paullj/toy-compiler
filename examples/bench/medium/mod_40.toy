fn f_40_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_40_10(n)
}
fn tag_40(e: E_40) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_40 { a: n, b: 40 }
    return f_40_11(s.a) + tag_40(E_40.Hi(s.b))
}
