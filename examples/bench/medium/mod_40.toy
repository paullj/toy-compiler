fn f_40_7(n: int) -> int {
    acc := n + 7
    for j in 0..4 {
        acc = acc + j * 7
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_40_6(n)
}
fn f_40_8(n: int) -> int {
    acc := n + 8
    for j in 0..4 {
        acc = acc + j * 8
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_40_7(n)
