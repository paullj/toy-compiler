import mod_39
struct S_40 { a: int, b: int }
enum E_40 { Lo, Hi(int) }
fn f_40_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_39.entry(n)
}
fn f_40_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_40_0(n)
}
