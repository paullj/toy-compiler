import mod_60
struct S_61 { a: int, b: int }
enum E_61 { Lo, Hi(int) }
fn f_61_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_60.entry(n)
}
fn f_61_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
