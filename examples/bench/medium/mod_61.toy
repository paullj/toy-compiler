fn tag_61(e: E_61) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_61 { a: n, b: 61 }
    return f_61_11(s.a) + tag_61(E_61.Hi(s.b))
}
