# bench/medium — small integer helpers (control flow + recursion).
pub fn maxi(a: int, b: int) -> int { if a > b { a } else { b } }

pub fn mini(a: int, b: int) -> int { if a < b { a } else { b } }

pub fn absi(n: int) -> int { if n < 0 { 0 - n } else { n } }

pub fn powi(base: int, exp: int) -> int {
    r := 1
    i := 0
    while i < exp {
        r = r * base
        i = i + 1
    }
    return r
}

pub fn sumto(n: int) -> int {
    s := 0
    for i in 0..n {
        s = s + i
    }
    return s
}

pub fn fib(n: int) -> int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}
