import mod_41
struct S_42 { a: int, b: int }
enum E_42 { Lo, Hi(int) }
fn f_42_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_41.entry(n)
}
fn f_42_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_42_0(n)
}
