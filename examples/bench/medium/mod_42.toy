fn f_42_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_42_10(n)
}
fn tag_42(e: E_42) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_42 { a: n, b: 42 }
    return f_42_11(s.a) + tag_42(E_42.Hi(s.b))
}
