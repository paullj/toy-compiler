import mod_59
struct S_60 { a: int, b: int }
enum E_60 { Lo, Hi(int) }
fn f_60_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_59.entry(n)
}
fn f_60_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_60_0(n)
}
