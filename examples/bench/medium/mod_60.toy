fn f_60_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_60_10(n)
}
fn tag_60(e: E_60) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_60 { a: n, b: 60 }
    return f_60_11(s.a) + tag_60(E_60.Hi(s.b))
}
