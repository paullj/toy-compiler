import mod_96
struct S_97 { a: int, b: int }
enum E_97 { Lo, Hi(int) }
fn f_97_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_96.entry(n)
}
fn f_97_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_97_0(n)
}
