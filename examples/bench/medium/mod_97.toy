fn f_97_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_97_10(n)
}
fn tag_97(e: E_97) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_97 { a: n, b: 97 }
    return f_97_11(s.a) + tag_97(E_97.Hi(s.b))
}
