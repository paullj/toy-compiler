import mod_52
struct S_53 { a: int, b: int }
enum E_53 { Lo, Hi(int) }
fn f_53_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_52.entry(n)
}
fn f_53_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_53_0(n)
}
