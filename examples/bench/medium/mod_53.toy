fn f_53_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_53_10(n)
}
fn tag_53(e: E_53) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_53 { a: n, b: 53 }
    return f_53_11(s.a) + tag_53(E_53.Hi(s.b))
}
