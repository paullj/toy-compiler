    acc := n + 7
    for j in 0..4 {
        acc = acc + j * 7
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_11_6(n)
}
fn f_11_8(n: int) -> int {
    acc := n + 8
    for j in 0..4 {
        acc = acc + j * 8
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_11_7(n)
}
fn f_11_9(n: int) -> int {
    acc := n + 9
    for j in 0..4 {
        acc = acc + j * 9
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_11_8(n)
