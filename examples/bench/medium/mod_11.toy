import mod_10
struct S_11 { a: int, b: int }
enum E_11 { Lo, Hi(int) }
fn f_11_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_10.entry(n)
}
fn f_11_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_11_0(n)
}
