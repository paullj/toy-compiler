fn f_11_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_11_10(n)
}
fn tag_11(e: E_11) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_11 { a: n, b: 11 }
    return f_11_11(s.a) + tag_11(E_11.Hi(s.b))
}
