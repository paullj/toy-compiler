import mod_79
struct S_80 { a: int, b: int }
enum E_80 { Lo, Hi(int) }
fn f_80_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_79.entry(n)
}
fn f_80_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_80_0(n)
}
