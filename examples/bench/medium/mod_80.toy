fn f_80_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_80_10(n)
}
fn tag_80(e: E_80) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_80 { a: n, b: 80 }
    return f_80_11(s.a) + tag_80(E_80.Hi(s.b))
}
