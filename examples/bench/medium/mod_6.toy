import mod_5
struct S_6 { a: int, b: int }
enum E_6 { Lo, Hi(int) }
fn f_6_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_5.entry(n)
}
fn f_6_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_6_0(n)
}
