fn f_6_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_6_10(n)
}
fn tag_6(e: E_6) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_6 { a: n, b: 6 }
    return f_6_11(s.a) + tag_6(E_6.Hi(s.b))
}
