import mod_35
struct S_36 { a: int, b: int }
enum E_36 { Lo, Hi(int) }
fn f_36_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_35.entry(n)
}
fn f_36_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_36_0(n)
}
