fn f_36_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_36_10(n)
}
fn tag_36(e: E_36) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_36 { a: n, b: 36 }
    return f_36_11(s.a) + tag_36(E_36.Hi(s.b))
}
