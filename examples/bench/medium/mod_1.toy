import mod_0
struct S_1 { a: int, b: int }
enum E_1 { Lo, Hi(int) }
fn f_1_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_0.entry(n)
}
fn f_1_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_0(n)
}
fn f_1_2(n: int) -> int {
    acc := n + 2
    for j in 0..4 {
        acc = acc + j * 2
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_1(n)
}
