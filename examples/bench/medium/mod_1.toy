    acc := n + 6
    for j in 0..4 {
        acc = acc + j * 6
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_5(n)
}
fn f_1_7(n: int) -> int {
    acc := n + 7
    for j in 0..4 {
        acc = acc + j * 7
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_6(n)
}
fn f_1_8(n: int) -> int {
    acc := n + 8
    for j in 0..4 {
        acc = acc + j * 8
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_7(n)
}
fn f_1_9(n: int) -> int {
    acc := n + 9
    for j in 0..4 {
        acc = acc + j * 9
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_8(n)
}
fn f_1_10(n: int) -> int {
    acc := n + 10
    for j in 0..4 {
        acc = acc + j * 10
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_9(n)
}
fn f_1_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_10(n)
}
fn tag_1(e: E_1) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_1 { a: n, b: 1 }
    return f_1_11(s.a) + tag_1(E_1.Hi(s.b))
}
