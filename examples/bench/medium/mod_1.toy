    acc := n + 3
    for j in 0..4 {
        acc = acc + j * 3
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_2(n)
}
fn f_1_4(n: int) -> int {
    acc := n + 4
    for j in 0..4 {
        acc = acc + j * 4
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_3(n)
}
fn f_1_5(n: int) -> int {
    acc := n + 5
    for j in 0..4 {
        acc = acc + j * 5
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_1_4(n)
}
