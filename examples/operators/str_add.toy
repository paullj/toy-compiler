# Feature: `str + str` concatenates into a `String`, but only when `String` is in scope
# (via `import std/string`). Without the import there is no `String` type to produce, so
# concatenation is a compile error naming the required import.
# expect: compile-error "requires 'String' in scope"
fn main() -> int {
    s := "a" + "b"
    return 0
}
