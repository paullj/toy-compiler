# Regression (#132): `MapIter` and `SetIter` are pub structs, so user code can build one
# with a negative `i`. `next` used to test only `i >= len` and read before the entry array
# (a far index segfaulted, a near one returned garbage). A negative cursor now yields none.
# expect: exit 7
import std/map
import std/set

fn main() -> int {
    m := Map[int, int].new()
    m.set(1, 2)
    s := Set[int].new()
    s.add(5)
    far := MapIter[int, int] { m: m, i: -1000001 }
    near := MapIter[int, int] { m: m, i: -2 }
    si := SetIter[int] { m: s.m, i: -2 }
    r := 0
    r += match far.next() { .some(_) -> 100, .none -> 1 }
    r += match near.next() { .some(_) -> 100, .none -> 1 }
    r += match si.next() { .some(_) -> 100, .none -> 1 }
    for k, v in m { r += k + v - 2 }
    for x in s { r += x - 2 }
    return r
}
