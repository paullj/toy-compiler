import mod_77
struct S_78 { a: int, b: int }
enum E_78 { Lo, Hi(int) }
fn f_78_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_77.entry(n)
}
fn f_78_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_78_0(n)
}
