    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_78_10(n)
}
fn tag_78(e: E_78) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_78 { a: n, b: 78 }
    return f_78_11(s.a) + tag_78(E_78.Hi(s.b))
}
