import mod_12
struct S_13 { a: int, b: int }
enum E_13 { Lo, Hi(int) }
fn f_13_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_12.entry(n)
}
fn f_13_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_13_0(n)
}
