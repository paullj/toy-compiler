fn f_13_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_13_10(n)
}
fn tag_13(e: E_13) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_13 { a: n, b: 13 }
    return f_13_11(s.a) + tag_13(E_13.Hi(s.b))
}
