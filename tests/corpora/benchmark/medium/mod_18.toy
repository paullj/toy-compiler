import mod_17
struct S_18 { a: int, b: int }
enum E_18 { Lo, Hi(int) }
fn f_18_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_17.entry(n)
}
fn f_18_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_18_0(n)
}
