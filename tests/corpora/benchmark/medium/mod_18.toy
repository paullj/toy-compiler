fn tag_18(e: E_18) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_18 { a: n, b: 18 }
    return f_18_11(s.a) + tag_18(E_18.Hi(s.b))
}
