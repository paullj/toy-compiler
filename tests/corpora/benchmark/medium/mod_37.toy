fn f_37_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_37_10(n)
}
fn tag_37(e: E_37) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_37 { a: n, b: 37 }
    return f_37_11(s.a) + tag_37(E_37.Hi(s.b))
}
