import mod_36
struct S_37 { a: int, b: int }
enum E_37 { Lo, Hi(int) }
fn f_37_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_36.entry(n)
}
fn f_37_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_37_0(n)
}
