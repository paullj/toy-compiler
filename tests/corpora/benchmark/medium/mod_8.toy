fn f_8_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_8_10(n)
}
fn tag_8(e: E_8) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_8 { a: n, b: 8 }
    return f_8_11(s.a) + tag_8(E_8.Hi(s.b))
}
