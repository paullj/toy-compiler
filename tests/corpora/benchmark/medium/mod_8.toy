import mod_7
struct S_8 { a: int, b: int }
enum E_8 { Lo, Hi(int) }
fn f_8_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_7.entry(n)
}
fn f_8_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_8_0(n)
}
