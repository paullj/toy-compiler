fn f_98_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_98_10(n)
}
fn tag_98(e: E_98) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_98 { a: n, b: 98 }
    return f_98_11(s.a) + tag_98(E_98.Hi(s.b))
}
