import mod_97
struct S_98 { a: int, b: int }
enum E_98 { Lo, Hi(int) }
fn f_98_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_97.entry(n)
}
fn f_98_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_98_0(n)
}
