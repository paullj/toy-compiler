import mod_57
struct S_58 { a: int, b: int }
enum E_58 { Lo, Hi(int) }
fn f_58_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_57.entry(n)
}
