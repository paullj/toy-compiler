fn f_99_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_99_10(n)
}
fn tag_99(e: E_99) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_99 { a: n, b: 99 }
    return f_99_11(s.a) + tag_99(E_99.Hi(s.b))
}
