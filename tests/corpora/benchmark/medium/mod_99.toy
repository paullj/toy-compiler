import mod_98
struct S_99 { a: int, b: int }
enum E_99 { Lo, Hi(int) }
fn f_99_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_98.entry(n)
}
fn f_99_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_99_0(n)
}
