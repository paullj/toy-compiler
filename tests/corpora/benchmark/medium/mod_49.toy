fn f_49_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_49_10(n)
}
fn tag_49(e: E_49) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_49 { a: n, b: 49 }
    return f_49_11(s.a) + tag_49(E_49.Hi(s.b))
}
