import mod_48
struct S_49 { a: int, b: int }
enum E_49 { Lo, Hi(int) }
fn f_49_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_48.entry(n)
}
fn f_49_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_49_0(n)
}
