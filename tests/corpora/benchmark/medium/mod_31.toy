import mod_30
struct S_31 { a: int, b: int }
enum E_31 { Lo, Hi(int) }
fn f_31_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_30.entry(n)
}
fn f_31_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_31_0(n)
}
