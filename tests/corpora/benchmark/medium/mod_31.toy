fn f_31_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_31_10(n)
}
fn tag_31(e: E_31) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_31 { a: n, b: 31 }
    return f_31_11(s.a) + tag_31(E_31.Hi(s.b))
}
