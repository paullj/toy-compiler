import mod_6
struct S_7 { a: int, b: int }
enum E_7 { Lo, Hi(int) }
fn f_7_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_6.entry(n)
}
fn f_7_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_7_0(n)
}
fn f_7_2(n: int) -> int {
    acc := n + 2
    for j in 0..4 {
        acc = acc + j * 2
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_7_1(n)
}
