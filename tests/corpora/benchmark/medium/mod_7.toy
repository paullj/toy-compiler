fn f_7_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_7_10(n)
}
fn tag_7(e: E_7) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_7 { a: n, b: 7 }
    return f_7_11(s.a) + tag_7(E_7.Hi(s.b))
}
