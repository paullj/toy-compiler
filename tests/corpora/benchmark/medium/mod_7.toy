    acc := n + 4
    for j in 0..4 {
        acc = acc + j * 4
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_7_3(n)
}
fn f_7_5(n: int) -> int {
    acc := n + 5
    for j in 0..4 {
        acc = acc + j * 5
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_7_4(n)
}
fn f_7_6(n: int) -> int {
    acc := n + 6
    for j in 0..4 {
        acc = acc + j * 6
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_7_5(n)
}
fn f_7_7(n: int) -> int {
    acc := n + 7
    for j in 0..4 {
        acc = acc + j * 7
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_7_6(n)
}
fn f_7_8(n: int) -> int {
    acc := n + 8
    for j in 0..4 {
        acc = acc + j * 8
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_7_7(n)
}
fn f_7_9(n: int) -> int {
    acc := n + 9
    for j in 0..4 {
        acc = acc + j * 9
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_7_8(n)
