import mod_89
struct S_90 { a: int, b: int }
enum E_90 { Lo, Hi(int) }
fn f_90_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_89.entry(n)
}
fn f_90_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_90_0(n)
}
