fn f_90_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_90_10(n)
}
fn tag_90(e: E_90) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_90 { a: n, b: 90 }
    return f_90_11(s.a) + tag_90(E_90.Hi(s.b))
}
