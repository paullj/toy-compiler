import mod_74
struct S_75 { a: int, b: int }
enum E_75 { Lo, Hi(int) }
fn f_75_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_74.entry(n)
}
fn f_75_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_75_0(n)
}
