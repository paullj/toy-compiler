fn f_75_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_75_10(n)
}
fn tag_75(e: E_75) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_75 { a: n, b: 75 }
    return f_75_11(s.a) + tag_75(E_75.Hi(s.b))
}
