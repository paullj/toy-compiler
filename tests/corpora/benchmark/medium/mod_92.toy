import mod_91
struct S_92 { a: int, b: int }
enum E_92 { Lo, Hi(int) }
fn f_92_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_91.entry(n)
}
