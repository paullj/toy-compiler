fn tag_92(e: E_92) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_92 { a: n, b: 92 }
    return f_92_11(s.a) + tag_92(E_92.Hi(s.b))
}
