fn f_62_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_62_10(n)
}
fn tag_62(e: E_62) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_62 { a: n, b: 62 }
    return f_62_11(s.a) + tag_62(E_62.Hi(s.b))
}
