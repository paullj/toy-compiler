import mod_61
struct S_62 { a: int, b: int }
enum E_62 { Lo, Hi(int) }
fn f_62_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_61.entry(n)
}
fn f_62_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_62_0(n)
}
