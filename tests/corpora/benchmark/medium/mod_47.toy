import mod_46
struct S_47 { a: int, b: int }
enum E_47 { Lo, Hi(int) }
fn f_47_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_46.entry(n)
}
fn f_47_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_47_0(n)
}
