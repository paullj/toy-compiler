fn tag_47(e: E_47) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_47 { a: n, b: 47 }
    return f_47_11(s.a) + tag_47(E_47.Hi(s.b))
}
