import mod_63
struct S_64 { a: int, b: int }
enum E_64 { Lo, Hi(int) }
fn f_64_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_63.entry(n)
}
fn f_64_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_64_0(n)
}
