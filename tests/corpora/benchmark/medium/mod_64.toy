fn f_64_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_64_10(n)
}
fn tag_64(e: E_64) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_64 { a: n, b: 64 }
    return f_64_11(s.a) + tag_64(E_64.Hi(s.b))
}
