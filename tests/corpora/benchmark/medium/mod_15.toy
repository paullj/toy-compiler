    acc := n + 3
    for j in 0..4 {
        acc = acc + j * 3
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_2(n)
}
fn f_15_4(n: int) -> int {
    acc := n + 4
    for j in 0..4 {
        acc = acc + j * 4
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_3(n)
}
fn f_15_5(n: int) -> int {
    acc := n + 5
    for j in 0..4 {
        acc = acc + j * 5
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_4(n)
}
fn f_15_6(n: int) -> int {
    acc := n + 6
    for j in 0..4 {
        acc = acc + j * 6
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_5(n)
}
fn f_15_7(n: int) -> int {
    acc := n + 7
    for j in 0..4 {
        acc = acc + j * 7
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_6(n)
}
fn f_15_8(n: int) -> int {
    acc := n + 8
    for j in 0..4 {
        acc = acc + j * 8
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_7(n)
}
fn f_15_9(n: int) -> int {
    acc := n + 9
    for j in 0..4 {
        acc = acc + j * 9
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_8(n)
}
fn f_15_10(n: int) -> int {
    acc := n + 10
    for j in 0..4 {
        acc = acc + j * 10
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_9(n)
}
fn f_15_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_10(n)
}
fn tag_15(e: E_15) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_15 { a: n, b: 15 }
    return f_15_11(s.a) + tag_15(E_15.Hi(s.b))
}
