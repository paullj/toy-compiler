import mod_14
struct S_15 { a: int, b: int }
enum E_15 { Lo, Hi(int) }
fn f_15_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_14.entry(n)
}
fn f_15_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_0(n)
}
fn f_15_2(n: int) -> int {
    acc := n + 2
    for j in 0..4 {
        acc = acc + j * 2
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_15_1(n)
}
