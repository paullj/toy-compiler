import mod_34
struct S_35 { a: int, b: int }
enum E_35 { Lo, Hi(int) }
fn f_35_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_34.entry(n)
}
fn f_35_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_35_0(n)
}
