fn f_35_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_35_10(n)
}
fn tag_35(e: E_35) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_35 { a: n, b: 35 }
    return f_35_11(s.a) + tag_35(E_35.Hi(s.b))
}
