fn f_45_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_45_10(n)
}
fn tag_45(e: E_45) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_45 { a: n, b: 45 }
    return f_45_11(s.a) + tag_45(E_45.Hi(s.b))
}
