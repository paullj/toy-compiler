import mod_44
struct S_45 { a: int, b: int }
enum E_45 { Lo, Hi(int) }
fn f_45_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_44.entry(n)
}
fn f_45_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_45_0(n)
}
