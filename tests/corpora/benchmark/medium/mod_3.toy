    acc := n + 6
    for j in 0..4 {
        acc = acc + j * 6
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_5(n)
}
fn f_3_7(n: int) -> int {
    acc := n + 7
    for j in 0..4 {
        acc = acc + j * 7
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_6(n)
}
fn f_3_8(n: int) -> int {
    acc := n + 8
    for j in 0..4 {
        acc = acc + j * 8
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_7(n)
}
fn f_3_9(n: int) -> int {
    acc := n + 9
    for j in 0..4 {
        acc = acc + j * 9
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_8(n)
}
fn f_3_10(n: int) -> int {
    acc := n + 10
    for j in 0..4 {
        acc = acc + j * 10
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_9(n)
}
fn f_3_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_10(n)
}
fn tag_3(e: E_3) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_3 { a: n, b: 3 }
    return f_3_11(s.a) + tag_3(E_3.Hi(s.b))
}
