import mod_2
struct S_3 { a: int, b: int }
enum E_3 { Lo, Hi(int) }
fn f_3_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_2.entry(n)
}
fn f_3_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_0(n)
}
fn f_3_2(n: int) -> int {
    acc := n + 2
    for j in 0..4 {
        acc = acc + j * 2
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_1(n)
}
fn f_3_3(n: int) -> int {
    acc := n + 3
    for j in 0..4 {
        acc = acc + j * 3
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_2(n)
}
fn f_3_4(n: int) -> int {
    acc := n + 4
    for j in 0..4 {
        acc = acc + j * 4
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_3(n)
}
fn f_3_5(n: int) -> int {
    acc := n + 5
    for j in 0..4 {
        acc = acc + j * 5
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_3_4(n)
}
