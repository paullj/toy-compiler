fn tag_0(e: E_0) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_0 { a: n, b: 0 }
    return f_0_11(s.a) + tag_0(E_0.Hi(s.b))
}
