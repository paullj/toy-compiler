    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_93_10(n)
}
fn tag_93(e: E_93) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_93 { a: n, b: 93 }
    return f_93_11(s.a) + tag_93(E_93.Hi(s.b))
}
