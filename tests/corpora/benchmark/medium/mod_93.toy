import mod_92
struct S_93 { a: int, b: int }
enum E_93 { Lo, Hi(int) }
fn f_93_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_92.entry(n)
}
fn f_93_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_93_0(n)
}
