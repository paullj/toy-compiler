import mod_37
struct S_38 { a: int, b: int }
enum E_38 { Lo, Hi(int) }
fn f_38_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_37.entry(n)
}
fn f_38_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_38_0(n)
}
