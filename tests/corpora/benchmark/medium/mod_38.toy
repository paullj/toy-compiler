fn tag_38(e: E_38) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_38 { a: n, b: 38 }
    return f_38_11(s.a) + tag_38(E_38.Hi(s.b))
}
