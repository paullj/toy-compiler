import mod_72
struct S_73 { a: int, b: int }
enum E_73 { Lo, Hi(int) }
fn f_73_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_72.entry(n)
}
fn f_73_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
