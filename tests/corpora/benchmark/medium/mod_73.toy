fn tag_73(e: E_73) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_73 { a: n, b: 73 }
    return f_73_11(s.a) + tag_73(E_73.Hi(s.b))
}
