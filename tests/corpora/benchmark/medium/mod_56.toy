fn tag_56(e: E_56) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_56 { a: n, b: 56 }
    return f_56_11(s.a) + tag_56(E_56.Hi(s.b))
}
