import mod_55
struct S_56 { a: int, b: int }
enum E_56 { Lo, Hi(int) }
fn f_56_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_55.entry(n)
}
fn f_56_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_56_0(n)
}
