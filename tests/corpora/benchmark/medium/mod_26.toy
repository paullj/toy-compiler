fn f_26_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_26_10(n)
}
fn tag_26(e: E_26) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_26 { a: n, b: 26 }
    return f_26_11(s.a) + tag_26(E_26.Hi(s.b))
}
