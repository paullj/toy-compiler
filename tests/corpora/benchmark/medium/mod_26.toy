import mod_25
struct S_26 { a: int, b: int }
enum E_26 { Lo, Hi(int) }
fn f_26_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_25.entry(n)
}
fn f_26_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_26_0(n)
}
