import mod_19
struct S_20 { a: int, b: int }
enum E_20 { Lo, Hi(int) }
fn f_20_0(n: int) -> int {
    acc := n + 0
    for j in 0..4 {
        acc = acc + j * 0
    }
    if acc < 0 { acc = 0 - acc }
    return acc + mod_19.entry(n)
}
fn f_20_1(n: int) -> int {
    acc := n + 1
    for j in 0..4 {
        acc = acc + j * 1
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_20_0(n)
}
