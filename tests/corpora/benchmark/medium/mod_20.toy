fn f_20_9(n: int) -> int {
    acc := n + 9
    for j in 0..4 {
        acc = acc + j * 9
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_20_8(n)
}
fn f_20_10(n: int) -> int {
    acc := n + 10
    for j in 0..4 {
        acc = acc + j * 10
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_20_9(n)
}
fn f_20_11(n: int) -> int {
    acc := n + 11
    for j in 0..4 {
        acc = acc + j * 11
    }
    if acc < 0 { acc = 0 - acc }
    return acc + f_20_10(n)
}
fn tag_20(e: E_20) -> int { match e { .Lo -> 0, .Hi(v) -> v } }
pub fn entry(n: int) -> int {
    s := S_20 { a: n, b: 20 }
    return f_20_11(s.a) + tag_20(E_20.Hi(s.b))
}
