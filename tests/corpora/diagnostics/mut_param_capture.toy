struct P { x: int }

impl P {
    fn get(self) -> int { self.x }
}

fn by_lambda(mut n: int) -> fn() -> int {
    fn() -> int { n }  #~ ERROR [T0052] a closure that escapes cannot capture the 'mut' parameter 'n'; copy it to a local first
}

fn by_local_fn(mut n: int) -> fn() -> int {
    fn peek() -> int { n }  #~ ERROR [T0052] a closure that escapes cannot capture the 'mut' parameter 'n'; copy it to a local first
    peek
}

fn by_bound(mut p: P) -> fn() -> int {
    p.get  #~ ERROR [T0052] a closure that escapes cannot capture the 'mut' parameter 'p'; copy it to a local first
}

fn copied(mut n: int) -> int {
    m := n
    h := fn() -> int { m }
    n = 0
    h()
}

fn main() -> int {
    a := 1
    p := P { x: 2 }
    f := by_lambda(a)
    g := by_local_fn(a)
    h := by_bound(p)
    return f() + g() + h() + copied(a)
}
