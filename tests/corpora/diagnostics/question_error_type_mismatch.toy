# `?` on a `Result` whose error type differs from the enclosing `Result`'s error type is
# a mismatch: the `err(e)` residual could not be re-emitted at the enclosing error type
# without a conversion (`From`-widening is not yet supported) — T0033.

fn f(o: Result[int, bool]) -> Result[int, str] {
  v := o?  #~ ERROR [T0033] error type bool does not match
  return Result.ok(v)
}

fn main() -> int {
  return 0
}
