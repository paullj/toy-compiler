# A call result is no variable, so it cannot be assigned at all (R0007).
struct P { x: int }

impl P {
    fn get(self) -> P { self }
}

fn id[T](x: T) -> T { x }

fn main() -> int {
    p := P { x: 1 }
    p.get() = P { x: 2 }  #~ ERROR [R0007] cannot assign to a temporary value, such as a call result; only a variable or a field of one can be assigned
    id[P](p) = p  #~ ERROR [R0007] cannot assign to a temporary value
    return p.x
}
