protocol Show { fn render(self) -> int }
protocol Debug { fn render(self) -> int }

struct P { x: int }

impl P has Show {
    fn render(self) -> int { 1 }
}

impl P has Debug {
    fn render(self) -> int { 2 }
}

impl P has Into[int] {
    fn into(self) -> int { self.x }
}

impl P has Into[bool] {
    fn into(self) -> bool { self.x > 0 }
}

# A bound names the protocol, so these pick a conformance and check.
fn use_show[T has Show](t: T) -> int { t.render() }
fn use_debug[T has Debug](t: T) -> int { t.render() }
fn as_int[T has Into[int]](t: T) -> int { t.into() }

fn main() -> int {
    p := P { x: 0 }
    a := p.render()  #~ ERROR [T0025] (Show and Debug); call it through a fn bounded by 'Show', e.g. 'fn render_via[T has Show](x: T) -> int { x.render() }'
    b := P.render(p)  #~ ERROR [T0025] e.g. 'fn render_via[T has Show](x: T) -> int { x.render() }'
    c := p.into()  #~ ERROR [T0025] (Into[int] and Into[bool]); add explicit protocol type arguments, e.g. .into[int]() or .into[bool]()
    return a + b + c + use_show(p) + use_debug(p) + as_int(p)
}
