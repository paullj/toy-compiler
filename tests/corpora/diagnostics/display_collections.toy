# std renders Ref, Vec, Map and Set only where every type argument conforms to Display:
# the T0023 names the argument that fails the impl's bound. A struct holding such a box
# gets the plain field hint, not the managed-box one, since the box has an impl. A fn value
# renders, so `Sorted`'s Ord bound is what keeps these from rendering. A fn value is still
# no Map key: it is not Hashable.
import std/io
import std/map
import std/ref
import std/vec

struct Sorted[T] { v: T }

impl Sorted[T has Ord] has Display {
    fn display(self) -> str { "sorted" }
}

struct Holder { r: Ref[Sorted[fn()]] }

fn hi() {}

fn main() {
    fs: Vec[Sorted[fn()]] = [Sorted { v: hi }]
    io.println(fs)  #~ ERROR [T0023] type 'Vec[Sorted[fn()]]' does not conform to protocol 'Display'; its generic impl needs type argument 'Sorted[fn()]' to conform to 'Display'
    io.println(Ref.new(Sorted { v: hi }))  #~ ERROR [T0023] type 'Ref[Sorted[fn()]]' does not conform to protocol 'Display'; its generic impl needs type argument 'Sorted[fn()]' to conform to 'Display'
    io.println(Map[int, Sorted[fn()]].new())  #~ ERROR [T0023] type 'Map[int, Sorted[fn()]]' does not conform to protocol 'Display'; its generic impl needs type argument 'Sorted[fn()]' to conform to 'Display'
    io.println(Holder { r: Ref.new(Sorted { v: hi }) })  #~ ERROR [T0023] type 'Holder' does not conform to protocol 'Display'; make every field of 'Holder' conform to 'Display'
    io.println(Map[fn(int) -> int, int].new())  #~ ERROR [T0023] function type 'fn(int) -> int' does not conform to protocol 'Hashable'
}
