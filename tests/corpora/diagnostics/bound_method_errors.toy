struct C { n: int }
struct H { c: C }

impl C {
    fn bump(mut self) { self.n = self.n + 1 }
    fn get(self) -> int { self.n }
    fn zero() -> C { C { n: 0 } }
    fn peek(mut self) -> fn() -> int {
        return self.get  #~ ERROR [T0052] a closure that escapes cannot capture the 'mut self' receiver 'self'; copy it to a local first
    }
}

fn mk() -> C { C { n: 0 } }

fn main() -> int {
    _a := mk().bump  #~ ERROR [T0019] cannot bind mutating method 'bump' to a temporary; the receiver must be a local variable
    h := H { c: C { n: 0 } }
    _b := h.c.bump  #~ ERROR [T0072] binding the 'mut self' method 'bump' needs a local receiver, not a field; bind it on a local variable
    c := C { n: 1 }
    _z := c.zero  #~ ERROR [T0018] 'zero' is an associated function, not a method; it has no receiver to bind
    s := "hi"
    _l := s.len  #~ ERROR [T0049] 'len' is a built-in method and cannot be used as a value; wrap the call in a lambda
    o: Option[int] = .some(1)
    _u := o.unwrap  #~ ERROR [T0049] 'unwrap' is a built-in method and cannot be used as a value; wrap the call in a lambda
    ok := c.get
    pk := c.peek()
    return ok() + h.c.n + pk()
}
