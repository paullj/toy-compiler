# `xs[i] = v` stores a whole element, so the element's type is the rhs's expectation and a
# wrong value names the element. A compound `xs[i] += v` is not supported yet (T0074). A
# `Map` has no index operator at all, so its store gets that error with a hint to `.set`.
import std/vec
import std/map

struct H { xs: Vec[int] }

fn main() -> int {
    xs: Vec[int] = [1, 2, 3]
    xs[1] = 7
    xs[1] = true  #~ ERROR [T0041] cannot assign bool to an element of type int
    xs[1] += 7  #~ ERROR [T0074] cannot assign to an index element
    h := H { xs: xs }
    h.xs[0] = 5
    vs: Vec[Vec[int]] = [[1]]
    vs[0][0] = 2
    m: Map[str, int] = Map[str, int].new()
    m["k"] = 1  #~ ERROR [T0057] Map has no index operator; use .set(k, v)
    return xs[1]
}
