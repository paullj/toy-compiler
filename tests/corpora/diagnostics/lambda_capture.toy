struct P { x: int }

fn main() -> int {
    base := 10
    p := P { x: 1 }
    _f := fn(v: int) -> int { v + base }  #~ ERROR [T0052] this lambda captures 'base'
    _g := fn() { p.x = 2 }  #~ ERROR [T0052] this lambda captures 'p'
    _h := fn() -> fn() -> int {
        fn() { base }  #~ ERROR [T0052] this lambda captures 'base'
    }
    return 0
}
