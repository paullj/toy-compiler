# A generic impl that bounds its own params conforms only the instances whose type args
# meet those bounds; the T0023 names the type arg that fails, as do '==', '<' and
# to_string, and the structural derive does not stand in for the impl. An impl at other
# protocol args names the args it gives.
import std/io

struct Pair[K, V] { k: K, v: V }

impl Pair[K has Display, V has Display] has Display {
    fn display(self) -> str { self.k.to_string().concat("=").concat(self.v.to_string()) }
}

struct Box[T] { v: T }

impl Box[T has Eq] has Display {
    fn display(self) -> str { "box" }
}

impl Box[T has Display] has Eq {
    fn eq(self, _o: Box[T]) -> bool { true }
}

impl Box[T has Display] has Ord {
    fn cmp(self, _o: Box[T]) -> Ordering { Ordering.eq }
}

struct Cell[T] { v: T }

impl Cell[T has Eq] has Display {
    fn display(self) -> str { "cell" }
}

protocol Conv[X] { fn conv(self) -> X }

impl Cell[T] has Conv[T] {
    fn conv(self) -> T { self.v }
}

fn go[T has Conv[int]](t: T) -> int { t.conv() }

# A fn value renders but is not Ord, so a Gate of one has no Display, and no Eq either.
struct Gate[T] { v: T }

impl Gate[T has Ord] has Display {
    fn display(self) -> str { "gate" }
}

struct NoShow { g: Gate[fn(int) -> int] }

struct Pt { x: int }

fn inc(x: int) -> int { x + 1 }

fn main() -> int {
    io.println(Pair { k: 1, v: true })
    io.println(Pair { k: 1, v: NoShow { g: Gate { v: inc } } })  #~ ERROR [T0023] type 'Pair' does not conform to protocol 'Display'; its generic impl needs type argument 'NoShow' to conform to 'Display'
    io.println(Pair { k: NoShow { g: Gate { v: inc } }, v: 1 })  #~ ERROR [T0023] its generic impl needs type argument 'NoShow' to conform to 'Display'
    io.println(Box { v: Pt { x: 1 } })
    io.println(Box { v: NoShow { g: Gate { v: inc } } })  #~ ERROR [T0023] type 'Box' does not conform to protocol 'Display'; its generic impl needs type argument 'NoShow' to conform to 'Eq'
    b := Box { v: NoShow { g: Gate { v: inc } } }
    io.println(b == b)  #~ ERROR [T0026] '==' requires an 'Eq' impl for type 'Box'; its generic impl needs type argument 'NoShow' to conform to 'Display'
    io.println(b < b)  #~ ERROR [T0027] '<' requires an 'Ord' impl for type 'Box'; its generic impl needs type argument 'NoShow' to conform to 'Display'
    c := Cell { v: NoShow { g: Gate { v: inc } } }
    s := c.to_string()  #~ ERROR [T0018] no method 'to_string' on type 'Cell'; its generic impl of 'Display' needs type argument 'NoShow' to conform to 'Eq'
    return go(Cell { v: true }) + s.len()  #~ ERROR [T0023] type 'Cell' does not conform to protocol 'Conv[int]'; its generic impl gives 'Conv[bool]'
}
