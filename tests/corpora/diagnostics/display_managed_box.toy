# A managed box (a Ref, or the gc_array storage inside Vec, Map and Set) never derives
# Display: the derive would print a heap address. Each print is a clean T0023 whose hint
# names the box instead of asking for the private storage to conform.
import std/io
import std/map
import std/ref
import std/set
import std/vec

struct Holder { r: Ref[int] }

fn main() {
    io.println([1, 2, 3])  #~ ERROR [T0023] type 'Vec' does not conform to protocol 'Display'; it is or holds a managed box
    io.println(Ref.new(42))  #~ ERROR [T0023] type 'Ref' does not conform to protocol 'Display'; it is or holds a managed box
    io.println(Map[int, str].new())  #~ ERROR [T0023] type 'Map' does not conform to protocol 'Display'; it is or holds a managed box
    io.println(Set[int].new())  #~ ERROR [T0023] type 'Set' does not conform to protocol 'Display'; it is or holds a managed box
    io.println(Holder { r: Ref.new(1) })  #~ ERROR [T0023] type 'Holder' does not conform to protocol 'Display'; it is or holds a managed box
}
