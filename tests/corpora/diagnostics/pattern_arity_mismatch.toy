# A variant pattern that binds a different number of values than the variant holds is
# T0068.
enum Shape { circle(int), rect(int, int), empty }

fn area(s: Shape) -> int {
    match s {  #~ ERROR [T0048] non-exhaustive match
        Shape.circle(r) -> r * r * 3
        Shape.rect(w) -> w  #~ ERROR [T0068] variant 'Shape.rect' binds 2 value(s), got 1
        Shape.empty(e) -> e  #~ ERROR [T0068] unit variant 'Shape.empty' binds no payload
    }
}

fn main() -> int {
    return area(Shape.empty)
}
