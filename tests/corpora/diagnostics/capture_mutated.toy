struct P { x: int }
struct C { n: int }
struct H { f: fn() }

impl C {
    fn bump(mut self) { self.n = self.n + 1 }
    fn get(self) -> int { self.n }
    fn peek(mut self) -> fn() -> int {
        fn() -> int { self.n }  #~ ERROR [T0052] a closure that escapes cannot capture the 'mut self' receiver 'self'
    }
    fn poke(mut self, h: H) {
        h.f = fn() { self.bump() }  #~ ERROR [T0052] a closure that escapes cannot capture the 'mut self' receiver 'self'
    }
    fn look(mut self) -> int {
        f := fn() -> int { self.n }
        f()
    }
    fn copy_first(mut self) -> int {
        n := self.n
        h := fn() -> int { n }
        self.bump()
        h()
    }
}

fn main() -> int {
    base := 10
    _ok := fn(v: int) -> int { v + base }
    a := 1
    _f := fn() -> int { a }
    a = 2
    p := P { x: 1 }
    _g := fn() { p.x = 2 }
    c := C { n: 0 }
    _h := fn() -> int { c.get() }
    c.bump()
    d := C { n: 0 }
    _k := fn() { d.bump() }
    pk := c.peek()
    c.poke(H { f: fn() {} })
    return a + c.n + pk() + c.look() + c.copy_first()
}
