# A call rejected with its own error does not also blame its lambda args: with no
# callee to give them a type, their params are left untyped without a T0050.
import std/vec

fn add(a: int, b: int) -> int { a + b }

fn main() -> int {
    xs: Vec[int] = [1, 2, 3]
    _a := xs.mapp(fn(v) { v + 1 })  #~ ERROR [T0018] no method 'mapp' on type 'Vec[int]'; did you mean 'map'?
    _b := 5.frob(add(1, _))  #~ ERROR [T0018] no method 'frob' on type 'int'
    _c := add(fn(v) { v })  #~ ERROR [T0039] expected 2 argument(s), got 1
    return 0
}
