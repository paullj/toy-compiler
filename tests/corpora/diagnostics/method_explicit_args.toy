# Explicit type args on a method of a generic type (#31): a method with type params of its
# own takes exactly that many; any other takes protocol args, which must name one of the
# receiver's conformances; a method of a non-generic type takes none.
protocol Into[U] {
    fn into(self) -> U
}

struct Box[T] { v: T }

impl Box[T] {
    fn none[U](self) -> Option[U] { Option[U].none }
    fn with[U](v: T, _u: U) -> Box[T] { Box { v: v } }
    fn get(self) -> T { self.v }
}

impl Box[T] has Into[int] {
    fn into(self) -> int { 1 }
}

struct K { v: int }

impl K {
    fn make() -> K { K { v: 1 } }
}

fn main() -> int {
    b := Box { v: 2 }
    _a := b.none[int, bool]()  #~ ERROR [T0054] 'none' takes 1 type argument(s) of its own, got 2
    _b := b.into[str]()  #~ ERROR [T0018] no method 'into' on type 'Box' for the given protocol type arguments
    _c := b.get[int]()  #~ ERROR [T0018] no method 'get' on type 'Box' for the given protocol type arguments
    _d := b.none()  #~ ERROR [T0016] add explicit type arguments, as in 'none[int](..)'
    _e := b.with[int](1, 2)  #~ ERROR [T0018] 'with' is an associated function
    _f := Box.with[bool](1, true)  #~ ERROR [T0016] e.g. Box[int].with
    _g := Box[int].get[int]()  #~ ERROR [T0018] for the given protocol type arguments
    _h := K.make[int]()  #~ ERROR [T0054] 'make' is not generic; drop the type arguments
    return 0
}
