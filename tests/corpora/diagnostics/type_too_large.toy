# A struct or enum too large for any frame is rejected at its declaration (#51).
struct A { a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int }
struct B { b0: A, b1: A, b2: A, b3: A, b4: A, b5: A, b6: A, b7: A }
struct C { c0: B, c1: B, c2: B, c3: B, c4: B, c5: B, c6: B, c7: B }
struct D { d0: C, d1: C, d2: C, d3: C, d4: C, d5: C, d6: C, d7: C }
struct E { e0: D, e1: D, e2: D, e3: D, e4: D, e5: D, e6: D, e7: D }
struct F { f0: E, f1: E, f2: E, f3: E, f4: E, f5: E, f6: E, f7: E }
struct G { g0: F, g1: F, g2: F, g3: F, g4: F, g5: F, g6: F, g7: F }  #~ ERROR [T0077] struct 'G' is 16777216 bytes, over the 16777200-byte limit for a value

# Only `G` is reported: a type that holds it is not reported again.
struct Big { g: G, tail: int }

impl Big {
    fn bump(mut self) { self.tail = self.tail + 1 }
}

fn poke(mut b: Big) { b.tail = 1 }

# 16777200 bytes exactly: the largest struct there can be. A frame that holds one
# also holds nothing else, so a fn that uses one in any way is too large for codegen.
# An `Option[Max]`, whose `Option` has no declaration, is reported at `Max`.
struct Max {  #~ ERROR [T0077] an instance of enum 'Option' holding 'Max' is 16777208 bytes
    f0: F, f1: F, f2: F, f3: F, f4: F, f5: F, f6: F,
    e0: E, e1: E, e2: E, e3: E, e4: E, e5: E, e6: E,
    d0: D, d1: D, d2: D, d3: D, d4: D, d5: D, d6: D,
    c0: C, c1: C, c2: C, c3: C, c4: C, c5: C, c6: C,
    b0: B, b1: B, b2: B, b3: B, b4: B, b5: B, b6: B,
    a0: A, a1: A, a2: A, a3: A, a4: A, a5: A, a6: A,
    x0: int, x1: int, x2: int, x3: int, x4: int, x5: int
}

# One word past it.
struct Over {  #~ ERROR [T0077] struct 'Over' is 16777208 bytes
    m: Max,
    x: int
}

# The tag makes an enum 8 bytes larger than its largest payload.
enum Blob {  #~ ERROR [T0077] enum 'Blob' is 16777224 bytes
    small(int),
    big(F, F, F, F, F, F, F, F)
}

struct Pair[T] { a: T, b: T }  #~ ERROR [T0077] an instance of struct 'Pair' is 16777216 bytes

struct Half { f0: F, f1: F, f2: F, f3: F }

fn maybe(o: Option[Max]) -> int {
    return 0
}

fn first(p: Pair[Half]) -> int {
    return p.a.f0.f0.e0.d0.c0.b0.a0
}

fn main() -> int {
    return 0
}
