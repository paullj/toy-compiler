fn add(a: int, b: int) -> int { a + b }

fn main() -> int {
    _a := add(_, _)  #~ ERROR [P0016] one '_'
    _b := add(_, 1, _)  #~ ERROR [P0016] one '_'
    _c := 3 |> add(_, _)  #~ ERROR [P0016] one '_'
    _d := 1 |> .m(1, _)  #~ ERROR [P0016] take no '_'
    _e := 1 |> .m(_, _)  #~ ERROR [P0016] take no '_'
    return 0
}
