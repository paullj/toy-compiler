# A call result has no home of its own, so assigning one of its fields would write a
# copy and lose the write (T0075), whether the call is a method's, a generic fn's or
# follows a field. A field of a local stays a place.
struct P { x: int }
struct W { p: P }

impl P {
    fn moved(self, d: int) -> P { P { x: self.x + d } }
}

fn id[T](x: T) -> T { x }

fn main() -> int {
    w := W { p: P { x: 1 } }
    w.p.moved(1).x = 5  #~ ERROR [T0075] cannot assign to a field of a temporary value, such as a call result; it is a copy, so the write would be lost
    id[P](w.p).x = 6  #~ ERROR [T0075] cannot assign to a field of a temporary value
    w.p.x = 2
    return w.p.x
}
