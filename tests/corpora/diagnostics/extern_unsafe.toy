import std/vec

extern {
    fn labs(x: int) -> int
}

fn main() -> int {
    a := labs(-1)  #~ ERROR [T0079] call to extern function 'labs' requires an 'unsafe' block
    b := -2 |> labs  #~ ERROR [T0079] call to extern function 'labs' requires an 'unsafe' block
    f := fn(x: int) -> int { labs(x) }  #~ ERROR [T0079] call to extern function 'labs' requires an 'unsafe' block
    g := unsafe { fn(x: int) -> int { labs(x) } }
    _h := labs  #~ ERROR [T0049] 'labs' is an extern function and cannot be used as a value
    xs := [1, 2].map(unsafe { fn(x: int) -> int { labs(x) } })
    return a + b + f(1) + g(2) + xs.len() + unsafe { labs(-3) }
}
