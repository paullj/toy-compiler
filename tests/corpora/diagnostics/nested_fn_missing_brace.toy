# A '}' is missing after the if block, so main's own '}' closes the if instead and
# helper below parses as a function nested in main. The block runs to the end of the
# file, and the error sits on helper, the column-1 fn it swallowed, where the '}' goes.
fn main() -> int {
    x := 1
    if x > 0 {
        x = 2
    return x
}

fn helper() -> int {  #~ ERROR [P0001] expected '}' before this 'fn': it was parsed as a function nested in the block above, which runs to the end of the file
    return 3
}
