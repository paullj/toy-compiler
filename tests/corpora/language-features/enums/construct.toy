# Feature: declare an enum with all 3 variant forms; construct each (qualified
# N.V AND inferred .V); match it to a value.
# expect: exit 37
# Circle(5) -> 25, Rect{3,4} -> 12, .Empty -> 0; 25 + 12 + 0 = 37.
enum Shape {
  Empty,
  Circle(int),
  Rect { w: int, h: int }
}

fn area(s: Shape) -> int {
  match s {
    .Circle(r) -> r * r,
    .Rect { w, h } -> w * h,
    .Empty -> 0
  }
}

fn main() -> int {
  c := Shape.Circle(5)
  r := Shape.Rect { w: 3, h: 4 }
  return area(c) + area(r) + area(.Empty)
}
