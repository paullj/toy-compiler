# Feature: closures and their envs survive collections forced between making and calling them
# expect: exit 42
import std/vec
import core/mem_selftest

struct Pt { x: int, y: int }

fn make(n: int, p: Pt, tag: str) -> fn() -> int {
    fn() -> int { n + p.x + p.y + tag.len() }
}

fn churn() -> int {
    i := 0
    loop {
        if i >= 20000 { break }
        j := i + 1000
        _g := fn() -> int { j }
        i = i + 1
    }
    return mem_selftest.churn_collects()
}

fn main() -> int {
    f := make(10, Pt { x: 3, y: 4 }, "abc")
    fs: Vec[fn() -> int] = []
    for k in 0..3 { fs.push(make(k, Pt { x: 1, y: 1 }, "")) }
    n := mem_selftest.forced_collect_count()
    c := churn()
    if n < 1 || c < 1 { return 1 }
    s := 0
    for j in 0..fs.len() { s = s + fs[j]() }
    return f() + s + 13
}
