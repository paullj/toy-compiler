# Feature: a `mut self` method bound as a value boxes its local receiver, so every call and the owner share one counter
# expect: exit 79
struct Counter { n: int }

impl Counter {
    fn bump(mut self) { self.n = self.n + 1 }
    fn add(mut self, k: int) { self.n = self.n + k }
    fn get(self) -> int { self.n }
}

fn twice(f: fn()) {
    f()
    f()
}

fn tally(c: Counter) -> int {
    add := c.add
    add(5)
    c.bump()
    c.n
}

fn main() -> int {
    c := Counter { n: 0 }
    inc := c.bump
    inc()
    inc()
    if c.n != 2 { return 1 }
    peek := c.get
    twice(inc)
    via := fn() { inc() }
    via()
    c.bump()
    loops := 0
    for i in 0..3 {
        d := Counter { n: i }
        step := d.bump
        step()
        loops = loops + d.n
    }
    return c.n * 10 + peek() + tally(Counter { n: 1 }) + loops
}
