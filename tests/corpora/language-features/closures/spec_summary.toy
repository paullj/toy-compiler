# Feature: the summary example of the closures spec, verbatim: a counter closure that
# boxes its captured `n`, a `mut` param that bumps the caller's local, and `Vec.each` over
# a list literal with a lambda that adds into `total`.
# expect: exit 9
import std/vec

fn counter() -> fn() -> int {
    n := 0
    fn() {                         # captures n by reference: n moves to a GC box
        n = n + 1
        n
    }
}

fn bump(mut x: int) { x = x + 1 }  # changes the caller's variable, no heap

fn main() -> int {
    next := counter()
    next()
    total := 0
    [1, 2, 3].each(fn(v) { total = total + v })
    bump(total)                    # total is now 7
    return next() + total          # 2 + 7 = 9
}
