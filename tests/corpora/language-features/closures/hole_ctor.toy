# Feature: a '_' capture over a constructor or a function value: a tuple variant, a tuple struct, and a call through a fn-typed local each take the parameter type they want at the '_'
# expect: exit 67
enum Shape {
    circle(int),
    square(int, int),
}

struct Pt(int, int)

fn area(s: Shape) -> int {
    return match s { .circle(r) -> 3 * r * r, .square(w, h) -> w * h }
}

fn sub(a: int, b: int) -> int { a - b }

fn main() -> int {
    circle := Shape.circle(_)
    rect := Shape.square(2, _)
    at := Pt(_, 4)
    g: fn(int, int) -> int = sub
    from10 := g(10, _)
    p := at(5)
    return area(circle(2)) + area(rect(7)) + p.0 + p.1 + from10(3) + 25
}
