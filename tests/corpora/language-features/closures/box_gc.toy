# Feature: boxes and the envs that point at them survive collections forced between their calls
# expect: exit 42
import std/vec
import std/gc

struct Pt { x: int, y: int }

fn counter() -> fn() -> int {
    n := 0
    fn() {
        n = n + 1
        n
    }
}

fn mover() -> fn() -> int {
    p := Pt { x: 0, y: 10 }
    fn() {
        p.x = p.x + 1
        p.x + p.y
    }
}

fn churn() -> int {
    before := gc.collections()
    i := 0
    loop {
        if i >= 20000 { break }
        j := i + 1000
        _g := fn() -> int { j }
        k := Pt { x: i, y: j }
        _h := fn() -> int { k.x }
        junk: Vec[int] = []
        junk.push(i)
        i = i + 1
    }
    return gc.collections() - before
}

fn main() -> int {
    c := counter()
    m := mover()
    c()
    m()
    fs: Vec[fn() -> int] = []
    for i in 0..3 {
        fs.push(fn() {
            i = i + 1
            i
        })
    }
    total := 0
    add := fn(v: int) { total = total + v }
    add(5)
    gc.collect()
    n := gc.collections()
    k := churn()
    if n < 1 || k < 1 { return 1 }
    add(c())
    s := 0
    for j in 0..fs.len() { s = s + fs[j]() }
    # total = 5 + 2, m() = 12, s = 1 + 2 + 3
    return total + m() + s + 17
}
