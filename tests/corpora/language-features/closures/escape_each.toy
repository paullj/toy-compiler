# Feature: a capturing lambda passed to `Vec.each`, or to a generic fn of the program's own,
# when either only calls it, keeps its env in the caller's frame and its accumulator unboxed
# at -O1, called through a method pipe, directly, or through the fn
# expect: stdout "6\n15\n24\n"
# expect: exit 45
import std/vec
import std/io

fn each_of[T](xs: Vec[T], f: fn(T)) {
    for x in xs { f(x) }
}

fn direct_call() -> int {
    ys: Vec[int] = [4, 5, 6]
    total := 0
    ys.each(fn(v: int) { total = total + v })
    total
}

fn via_free_fn() -> int {
    zs: Vec[int] = [7, 8, 9]
    total := 0
    each_of(zs, fn(v: int) { total = total + v })
    total
}

fn main() -> int {
    xs: Vec[int] = [1, 2, 3]
    total := 0
    xs |> .each(fn(v: int) { total = total + v })
    io.println(total)
    d := direct_call()
    io.println(d)
    f := via_free_fn()
    io.println(f)
    return total + d + f
}
