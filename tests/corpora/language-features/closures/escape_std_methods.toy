# Feature: every std method that takes a closure only calls it, so a capturing lambda passed
# to one keeps its env in the caller's frame at -O1 (no env cell and no box), and a lambda
# passed to one may capture a `mut` param of its caller.
# expect: stdout "40\n16\n"
# expect: exit 72
import std/vec
import std/option
import std/io

fn vec_methods() -> int {
    xs: Vec[int] = [3, 1, 2]
    total := 0
    xs.each(fn(v) { total = total + v })
    doubled := xs.map(fn(v) {
        total = total + 1
        v * 2
    })
    big := xs.filter(fn(v) {
        total = total + 1
        v > 1
    })
    sum := xs.fold(0, fn(acc, v) {
        total = total + 1
        acc + v
    })
    has_one := xs.any(fn(v) {
        total = total + 1
        v == 1
    })
    all_pos := xs.all(fn(v) {
        total = total + 1
        v > 0
    })
    two := xs.find(fn(v) {
        total = total + 1
        v == 2
    })
    xs.sort_by(fn(a, b) {
        total = total + 1
        a < b
    })
    flags := if has_one && all_pos { 1 } else { 0 }
    return total + doubled.len() + big.len() + sum + flags + two.unwrap_or(0)
}

fn vec_mut(mut acc: int, xs: Vec[int]) -> int {
    xs.each(fn(v) { acc = acc + v })
    _m := xs.map(fn(v) {
        acc = acc + 1
        v
    })
    _f := xs.filter(fn(v) {
        acc = acc + 1
        v > 0
    })
    _s := xs.fold(0, fn(a, v) {
        acc = acc + 1
        a + v
    })
    _a := xs.any(fn(v) {
        acc = acc + 1
        v < 0
    })
    _l := xs.all(fn(v) {
        acc = acc + 1
        v > 0
    })
    _d := xs.find(fn(v) {
        acc = acc + 1
        v < 0
    })
    xs.sort_by(fn(a, b) {
        acc = acc + 1
        a > b
    })
    acc
}

fn option_methods() -> int {
    o: Option[int] = Option.some(3)
    n: Option[int] = Option.none
    r: Result[int, str] = Result.ok(4)
    bad: Result[int, str] = Result.err("no")
    total := 0
    a := o.map(fn(v) {
        total = total + 1
        v * 2
    })
    b := o.then(fn(v) {
        total = total + 1
        Option.some(v + 1)
    })
    c := n.or_else(fn() {
        total = total + 1
        5
    })
    d := r.map(fn(v) {
        total = total + 1
        v + 1
    })
    e := r.then(fn(v) {
        total = total + 1
        Result[int, str].ok(v * 2)
    })
    f := bad.map_err(fn(m) {
        total = total + 1
        m.len()
    })
    g := bad.or_else(fn(m) {
        total = total + 1
        m.len() * 10
    })
    err_flag := if f.is_err() { 1 } else { 0 }
    return total + a.unwrap() + b.unwrap() + c + d.unwrap() + e.unwrap() + err_flag + g
}

fn option_mut(mut acc: int, o: Option[int], r: Result[int, str]) -> int {
    _a := o.map(fn(v) {
        acc = acc + 1
        v
    })
    _b := o.then(fn(v) {
        acc = acc + 1
        Option.some(v)
    })
    _c := o.or_else(fn() {
        acc = acc + 1
        0
    })
    _d := r.map(fn(v) {
        acc = acc + 1
        v
    })
    _e := r.then(fn(v) {
        acc = acc + 1
        Result[int, str].ok(v)
    })
    _f := r.map_err(fn(m) {
        acc = acc + 1
        m.len()
    })
    _g := r.or_else(fn(m) {
        acc = acc + 1
        m.len()
    })
    acc
}

fn main() -> int {
    a := vec_methods()
    b := 0
    ys: Vec[int] = [1, 2]
    c := vec_mut(b, ys)
    io.println(a)
    io.println(b)
    if option_methods() != 56 { return 1 }
    calls := 0
    o: Option[int] = Option.some(1)
    r: Result[int, str] = Result.ok(2)
    if option_mut(calls, o, r) != 4 || calls != 4 { return 2 }
    return a + b + c
}
