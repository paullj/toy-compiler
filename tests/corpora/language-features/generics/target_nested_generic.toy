# Feature: irrefutability of a SUBSTITUTED generic-enum-instance payload (a carryover
# bug, fixed later). `Wrap[T]`'s payload is `One[T]`; under `x: Wrap[int]` the pattern
# `.w(.only(n))` nests a variant pattern over the substituted payload `One[int]` — which
# is a composite `App`, not a plain `enumT`. The earlier exhaustiveness walk treated an
# `App` payload as always-refutable and spuriously reported "non-exhaustive: missing
# variant w"; the App-aware walk resolves `One[int]` as single-variant and total, so the
# single-arm match is exhaustive.
# expect: exit 42
enum One[T] { only(T) }
enum Wrap[T] { w(One[T]) }
fn f(x: Wrap[int]) -> int {
  return match x { .w(.only(n)) -> n }
}
fn main() -> int {
  return f(Wrap[int].w(One[int].only(42)))
}
