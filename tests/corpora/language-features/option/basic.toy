# Feature: `Option[T]` as a PRELUDE generic value enum — no import, no magic builtin
# tier. `Option[T] { some(T), none }` is native-registered as an ordinary generic enum
# template and monomorphized through the reify path exactly like a user enum: the
# instance `Option[int]` reifies to a plain concrete `enum_id` (8-byte tag + int payload).
# It models absence with no `nil`/`null`: `find` returns `some(n)` when present, else the
# nullary `none`, and `main` matches to unwrap the payload. `find` uses the early-return
# form (`return Option.some(n)`) with an explicit `Option[int].none` at the tail.
# expect: exit 42
fn find(n: int) -> Option[int] {
  if n > 0 { return Option.some(n) }
  return Option[int].none
}

fn main() -> int {
  return match find(42) {
    .some(v) -> v,
    .none -> 0,
  }
}
