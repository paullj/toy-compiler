# Feature: compiler-provided inherent methods on the prelude `Option[T]`/`Result[T,E]`
# enums. `is_some`/`is_none`/`is_ok`/`is_error` are predicates (`bool`); `expect(msg)`
# yields the payload (panics with `msg` on the absence/error variant); `or`
# yields the payload or a default. They are source-less native methods (no `t.methods`
# entry, like the builtin scalar `eq`/`hash`): the checker types them via normal `x.m()`
# dispatch and `lower` inlines the reified enum's tag test / payload load, so an unused
# method name emits zero codegen. Scalar-payload T here (int).
# expect: exit 42
fn main() -> int {
  a := Option[int].some(40)
  base := if a.is_some() { a.or(0) } else { 0 }   # 40
  b := Option[int].none
  extra := b.or(2)                                 # 2
  r := Result[int, str].ok(0)
  ok := if r.is_ok() { 0 } else { 99 }                   # 0
  return base + extra + ok                               # 42
}
