# Feature: float.parse reads back every printed float exactly, and rejects text with anything left over
# expect: stdout "ok\nnone\nnone\nnone\nnone\n2.5\ninf\n"
# expect: exit 0
import std/io
import std/float
import std/vec

fn round_trips(x: float) -> bool {
    return match float.parse(x.to_string()) {
        .some(y) -> y == x,
        .none -> false,
    }
}

fn show(s: str) {
    match float.parse(s) {
        .some(f) -> io.println(f),
        .none -> io.println("none"),
    }
}

fn main() -> int {
    samples := [0.1, 1.0, 1.5e300, 0.0 -. 2.5, 1.0 /. 3.0, 1.0 /. 0.0, 1e-5, 0.0001, 5e-324, 1e16, 9999999999999998.0, 123.456, 2.0 /. 7.0, 0.0 *. (0.0 -. 1.0)]
    ok := true
    for x in samples {
        if !round_trips(x) {
            io.println(x)
            ok = false
        }
    }
    if ok { io.println("ok") }
    show("")
    show(" 1.0")
    show("1.0x")
    show("1.0e")
    show("2.5")
    show("inf")
    return 0
}
