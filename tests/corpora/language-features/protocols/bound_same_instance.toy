# Feature: two params bounded by one generic protocol with different args (#97) take
# their own bound's conformance when a call gives both the same type, with inferred
# and explicit protocol args, from one value or two.
# expect: exit 5
struct P { x: int }

impl P has Into[int] {
    fn into(self) -> int { self.x }
}

impl P has Into[bool] {
    fn into(self) -> bool { self.x > 0 }
}

fn f[A has Into[int], B has Into[bool]](a: A, b: B) -> int {
    n: int = a.into()
    ok: bool = b.into()
    return if ok { n } else { 0 }
}

fn g[A has Into[int], B has Into[bool]](a: A, b: B) -> int {
    return if b.into[bool]() { a.into[int]() } else { 0 }
}

fn main() -> int {
    p := P { x: 5 }
    q := P { x: 0 }
    return f(p, p) + f(p, q) + g(q, p) + g(p, q)
}
