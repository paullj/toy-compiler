# Feature: `Vec.sort_by(less)` sorts in place by a comparator: `less(a, b)` is true when
# `a` goes first, so a `>` comparator sorts descending. The sort is stable: elements that
# compare equal keep their order, so sorting by `.k` alone gives "bdac".
# expect: stdout "9 5 3 1 \nbdac\n"
# expect: exit 9
import std/vec
import std/io

struct P { k: int, s: str }

fn main() -> int {
    xs: Vec[int] = [3, 9, 1, 5]
    xs.sort_by(fn(a, b) { a > b })
    xs.each(fn(v) { io.print(v.to_string().concat(" ")) })
    io.println("")
    ps: Vec[P] = [P { k: 2, s: "a" }, P { k: 1, s: "b" }, P { k: 2, s: "c" }, P { k: 1, s: "d" }]
    ps.sort_by(fn(a, b) { a.k < b.k })
    io.println(ps.fold("", fn(acc, p) { acc.concat(p.s) }))
    return xs.get(0).expect("no value")
}
