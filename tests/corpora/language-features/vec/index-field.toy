# expect: exit 7
# Feature: `xs[i].field` — indexing a Vec of a struct and reading a field off the element
# in one expression (previously the `[i]` misparsed as a type application and `.x` failed
# to compile, forcing a `p := ps[1]; p.x` binding).
import std/vec

struct P { x: int, y: int }

fn main() -> int {
    ps := [P{ x: 1, y: 2 }, P{ x: 3, y: 4 }]
    return ps[1].x + ps[1].y
}
