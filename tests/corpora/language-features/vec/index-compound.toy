# Feature: `xs[i] op= v` reads the element, applies `op` and stores the result through
# the same handle and index: every integer operator, a float element, a struct element
# with an `Add` impl, a field's `h.xs[i]`, a nested `vs[i][j]` and `self.xs[i]`.
# expect: stdout "13\n10\n30\n15\n3\n7\n5\n6\n24\n3\ntrue\n4\n6\n9\n8\n7\n"
# expect: exit 0
import std/io
import std/vec

struct V { x: int, y: int }
struct H { xs: Vec[int] }

impl V has Add {
    fn add(self, o: V) -> V { V { x: self.x + o.x, y: self.y + o.y } }
}

impl H {
    fn bump(self, i: int) { self.xs[i] += 7 }
}

fn main() -> int {
    xs: Vec[int] = [10]
    xs[0] += 3
    io.println(xs[0])
    xs[0] -= 3
    io.println(xs[0])
    xs[0] *= 3
    io.println(xs[0])
    xs[0] /= 2
    io.println(xs[0])
    xs[0] %= 4
    io.println(xs[0])
    xs[0] |= 4
    io.println(xs[0])
    xs[0] &= 13
    io.println(xs[0])
    xs[0] ^= 3
    io.println(xs[0])
    xs[0] <<= 2
    io.println(xs[0])
    xs[0] >>= 3
    io.println(xs[0])

    fs: Vec[float] = [1.0]
    fs[0] +.= 1.5
    io.println(fs[0] == 2.5)

    vs: Vec[V] = [V { x: 1, y: 2 }]
    vs[0] += V { x: 3, y: 4 }
    io.println(vs[0].x)
    io.println(vs[0].y)

    h := H { xs: [1, 2] }
    h.xs[1] += 7
    io.println(h.xs[1])
    h.bump(0)
    io.println(h.xs[0])

    ws: Vec[Vec[int]] = [[1, 2], [3, 4]]
    ws[1][1] += 3
    io.println(ws[1][1])
    return 0
}
