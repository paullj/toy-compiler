# Feature: `join` and `replace` copy each byte once, so a join of 20000 parts and a replace
# with 16384 matches finish quickly; part-by-part concatenation would take minutes
# expect: stdout "219999\n32768\n"
# expect: exit 0
import std/vec
import std/str
import std/io

fn many() -> Vec[str] {
    parts: Vec[str] = []
    i := 0
    while i < 20000 {
        parts.push("abcdefghij")
        i = i + 1
    }
    return parts
}

fn doubled(n: int) -> str {
    s := "x"
    i := 0
    while i < n {
        s = s.concat(s)
        i = i + 1
    }
    return s
}

fn main() -> int {
    s := ",".join(many())
    io.println(s.len())
    r := doubled(14).replace("x", "yy")
    io.println(r.len())
    if !s.ends_with(",abcdefghij") || !r.starts_with("yyyy") { return 1 }
    return 0
}
