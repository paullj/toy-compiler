# Feature: the `std/math` surface — pure-integer helpers plus libm float ops reached
# through `core/ffi`'s safe extern wrappers. `sqrt(16.0)` crosses the C-ABI boundary
# (f64 in a V-register) and returns 4.0, which truncates to 4; `4 + max(1, 3)` == 7.
# expect: stdout "math ok\n"
# expect: exit 7
import std/io
import std/math

fn main() -> int {
    io.print("math ok\n")
    root: int = math.sqrt(16.0).try_into().unwrap()
    return root + math.max(1, 3)
}
