# Feature: `str` has NO builtin `Add` — there is no `+` for strings. Concatenation is the
# method `.concat`, so `str + str` is a compile error (T0028) rather than a silent
# allocation behind an operator. `int` is the only builtin arithmetic type.
# expect: compile-error "requires an 'Add' impl for type 'str'"
fn main() -> int {
    _s := "a" + "b"
    return 0
}
