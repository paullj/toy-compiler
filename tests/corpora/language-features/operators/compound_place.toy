# Feature: `place op= v` works on every place `place = v` does: a struct field, a nested
# field chain, a tuple-struct field, a `mut` parameter and a field of `mut self`.
# expect: stdout "41\n12\n14\n6\n8\n"
# expect: exit 77
import std/io

struct In { n: int }
struct P { x: int, inner: In }
struct Pair(int, int)

impl P {
    fn grow(mut self, d: int) { self.inner.n *= d }
}

fn bump(mut n: int, by: int) { n += by }

fn main() -> int {
    p := P { x: 1, inner: In { n: 2 } }
    p.x += 40
    io.println(p.x)
    p.inner.n += 4
    p.grow(2)
    io.println(p.inner.n)
    t := Pair(1, 2)
    t.1 *= 7
    io.println(t.1)
    k := 1
    bump(k, 5)
    io.println(k)
    bump(p.inner.n, -4)
    bump(t.0, 7)
    io.println(t.0)
    return p.x + p.inner.n + t.1 + k + t.0
}
