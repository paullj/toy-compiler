# Feature: a frame of about 40 KiB builds and runs at -O0 and -O1: five 4 KiB struct locals and their call results put the later cells past the 32 KiB a scaled load or store reaches, so they are reached through a base built from the 4 KiB pages; the heap roots there (a `str`, a `Vec`, a struct's `str` field) survive collections while the frame is live (#32)
# expect: stdout "16\nfar\n9\nlast\n"
# expect: exit 0
import std/io
import std/vec

struct A { a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int }
struct B { b0: A, b1: A, b2: A, b3: A, b4: A, b5: A, b6: A, b7: A }
struct C { c0: B, c1: B, c2: B, c3: B, c4: B, c5: B, c6: B, c7: B, name: str }

fn a(x: int) -> A { A { a0: x, a1: x, a2: x, a3: x, a4: x, a5: x, a6: x, a7: x } }

fn b(x: int) -> B { B { b0: a(x), b1: a(x), b2: a(x), b3: a(x), b4: a(x), b5: a(x), b6: a(x), b7: a(x + 1) } }

fn c(x: int, name: str) -> C { C { c0: b(x), c1: b(x), c2: b(x), c3: b(x), c4: b(x), c5: b(x), c6: b(x), c7: b(x), name: name } }

fn churn() {
    i := 0
    while i < 20000 {
        junk: Vec[int] = []
        junk.push(i)
        i = i + 1
    }
}

fn main() -> int {
    x0 := c(1, "first")
    x1 := c(2, "second")
    x2 := c(3, "third")
    x3 := c(4, "fourth")
    x4 := c(5, "la".concat("st"))
    far := "f".concat("ar")
    held: Vec[int] = []
    held.push(9)
    churn()
    io.println(x0.c7.b7.a7 + x1.c0.b0.a0 + x2.c3.b3.a3 + x3.c6.b6.a6 + x4.c1.b1.a1)
    io.println(far)
    io.println(held.get(0).or(0))
    io.println(x4.name)
    return 0
}
