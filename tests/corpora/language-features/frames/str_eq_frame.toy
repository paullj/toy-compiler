# Feature: a function frame past 4095 bytes builds and runs: 20 inlined `str ==` (about 40 IR values each, every one with its own frame cell) give `count` a frame of several KiB at -O0 and -O1, its heap roots past the old limit survive collections while it is live (#32)
# expect: stdout "3\nkeep-me\n7\n"
# expect: exit 0
import std/io
import std/vec

fn churn() {
    i := 0
    while i < 20000 {
        junk: Vec[int] = []
        junk.push(i)
        i = i + 1
    }
}

fn count(s: str) -> int {
    t := 0
    if s == "w1" { t = t + 1 }
    if s == "w2" { t = t + 1 }
    if s == "w3" { t = t + 1 }
    if s == "w4" { t = t + 1 }
    if s == "w5" { t = t + 1 }
    if s == "w6" { t = t + 1 }
    if s == "w7" { t = t + 1 }
    if s == "w8" { t = t + 1 }
    if s == "w9" { t = t + 1 }
    if s == "w10" { t = t + 1 }
    if s == "w11" { t = t + 1 }
    if s == "w12" { t = t + 1 }
    if s == "w13" { t = t + 1 }
    if s == "w14" { t = t + 1 }
    if s == "w15" { t = t + 1 }
    if s == "w16" { t = t + 1 }
    if s == "w17" { t = t + 1 }
    if s == "w18" { t = t + 1 }
    if s == "w19" { t = t + 1 }
    if s == "w20" { t = t + 1 }
    if s.len() == 2 { t = t + 2 }
    # Declared after every comparison, so its cells sit past the first 4 KiB.
    keep := "keep".concat("-me")
    held: Vec[int] = []
    held.push(7)
    churn()
    io.println(t)
    io.println(keep)
    io.println(held.get(0).unwrap_or(0))
    t
}

fn main() -> int {
    return count("w7") - 3
}
