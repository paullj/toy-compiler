# Feature: a `?` after a method pipe applies to its call: `v |> .get(0)?` is `v.get(0)?`.
# A `?` mid-chain unwraps before the next step, so `v |> .get(1)? |> add(10)` is
# `add(v.get(1)?, 10)`.
# expect: exit 17
import std/vec

fn add(a: int, b: int) -> int { a + b }

fn first(v: Vec[int]) -> Option[int] {
    x := v |> .get(0)?
    return Option.some(x)
}

fn second_plus(v: Vec[int]) -> Option[int] {
    y := v |> .get(1)? |> add(10)
    return Option.some(y)
}

fn main() -> int {
    v := Vec[int].new()
    v.push(3)
    v.push(4)
    e := Vec[int].new()
    a := match first(v) { .some(x) -> x, .none -> 100 }          # 3
    b := match second_plus(v) { .some(x) -> x, .none -> 100 }    # 4 + 10 = 14
    c := match first(e) { .some(_) -> 50, .none -> 0 }           # empty: none
    d := match second_plus(e) { .some(_) -> 50, .none -> 0 }     # empty: none
    return a + b + c + d
}
