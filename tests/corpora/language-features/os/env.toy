# Feature: `os.env(name)` is some(value) for a set variable, an empty value included, and
# none for an unset one.
# env: GREETING=hello
# env: EMPTY=
# expect: stdout "hello\n[]\nunset\n"
# expect: exit 0
import std/io
import std/os
fn show(name: str) {
    match os.env(name) {
        .some(v) -> io.println(v),
        .none -> io.println("unset"),
    }
}
fn main() {
    show("GREETING")
    match os.env("EMPTY") {
        .some(v) -> io.println("[".concat(v).concat("]")),
        .none -> io.println("unset"),
    }
    show("MISSING")
}
