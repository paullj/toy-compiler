# Feature: `os.args()` holds argv[0] then each program argument, spaces kept.
# args: "a" "b c"
# expect: stdout "3\na\nb c\n"
# expect: exit 0
import std/io
import std/os
import std/vec
fn main() {
    xs := os.args()
    io.println(xs.len())
    for i in 1..xs.len() {
        io.println(xs[i])
    }
}
