# Feature: structural `Hash` derive on a PAYLOAD enum. An enum value hashes its
# discriminant (case-declaration order) folded into a fixed seed, then the active variant's
# payload fields. Two equal values hash EQUAL (Eq-consistent): `A(3)` == `A(3)` hash the
# same; `A(3)` and `A(4)` differ in payload; `A(3)` and `B` differ in discriminant. The
# empty variant `B` hashes just its tag. No source impl, no `derive` keyword.
enum E { A(int), B }

fn main() -> int {
    r := 0
    if E.A(3).hash() == E.A(3).hash() { r = r + 10 }      # equal tag + payload
    if E.A(3).hash() != E.A(4).hash() { r = r + 16 }      # equal tag, payload differs
    if E.A(3).hash() != E.B.hash() { r = r + 16 }         # differing tags
    if E.B.hash() == E.B.hash() { r = r + 0 }             # empty variant, stable
    return r
}
# expect: exit 42
