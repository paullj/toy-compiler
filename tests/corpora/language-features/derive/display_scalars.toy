# Feature: scalar `Display` renderers. `io.print(int)` renders digits via the never-negate
# `__int_to_str` — covering zero, a negative value (leading `-`), and a multi-digit value.
# `io.print(bool)` selects the `true`/`false` cstrings with a branch. The `"\n"` separators
# exercise the alloc-free `io.print(str)` path (a str renders to itself).
import std/io
fn main() {
    io.print(0)
    io.print("\n")
    io.print(-13)
    io.print("\n")
    io.print(4200)
    io.print("\n")
    io.print(true)
    io.print("\n")
    io.print(false)
}
# expect: stdout "0\n-13\n4200\ntrue\nfalse"
# expect: exit 0
