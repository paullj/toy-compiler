# Feature: structural `Display` derive on an ENUM. A `get_tag` dispatch ladder writes
# a bare `variant` for a unit variant, or `variant(<v0>, <v1>)` for a payload variant
# (payload fields in declaration order, `, `-separated). Each `print` writes directly to
# stdout; the `"\n"` separators are ordinary `str` prints (the raw write-bytes path).
import std/io
enum Shape { circle(int), square(int, int), point }

fn main() {
    io.print(Shape.circle(5))
    io.print("\n")
    io.print(Shape.square(3, 4))
    io.print("\n")
    io.print(Shape.point)
}
# expect: stdout "circle(5)\nsquare(3, 4)\npoint"
# expect: exit 0
