# Feature: a direct `.cmp(other)` call works wherever `<` does: on the builtin `Ord`
# scalars (int widths, bool, str), on a struct or enum with a derived `Ord`, on a generic
# instance (`B[int]`, `Option[int]`), and through a `[T has Ord]` bound at each of those.
# Each `both` line prints `cmp` and `<` side by side (lt=0, eq=1, gt=2), so the two forms
# must agree.
# expect: stdout "0\n2\n2\n2\n1\n2 0\n0 1\n0 1\n2 0\n2 0\n0 1\n0\n2\n2 0\n0 1\n"
# expect: exit 11
import std/io

struct P { x: int, y: int }
enum E { a, b(int) }
struct Q { v: int }
struct B[T] { v: T }

impl Q has Ord {
    fn cmp(self, other: Q) -> Ordering { other.v.cmp(self.v) }
}

fn code(o: Ordering) -> int {
    return match o { Ordering.lt -> 0, Ordering.eq -> 1, Ordering.gt -> 2 }
}

fn both[T has Ord](a: T, b: T) -> str {
    return code(a.cmp(b)).to_string().concat(" ").concat((if a < b { 1 } else { 0 }).to_string())
}

fn f[T has Ord](a: T, b: T) -> int {
    return match a.cmp(b) { Ordering.lt -> 1, _ -> 2 }
}

fn main() -> int {
    io.println(code(1.cmp(2)))
    io.println(code("b".cmp("a")))
    io.println(code(true.cmp(false)))
    hi: uint64 = 0x8000000000000000
    lo: uint64 = 1
    io.println(code(hi.cmp(lo)))
    o := 5.cmp(5)
    io.println(code(o))
    io.println(both(P { x: 1, y: 7 }, P { x: 1, y: 5 }))
    io.println(both(E.a, E.b(0)))
    io.println(both(E.b(1), E.b(2)))
    io.println(both(Q { v: 1 }, Q { v: 2 }))
    io.println(both("b", "a"))
    io.println(both(-3, 4))
    io.println(code(B[int] { v: 1 }.cmp(B[int] { v: 2 })))
    s: Option[int] = Option.some(3)
    n: Option[int] = Option.none
    io.println(code(n.cmp(s)))
    io.println(both(B[int] { v: 3 }, B[int] { v: 2 }))
    io.println(both(s, n))
    return f(1, 2) * 10 + f(P { x: 3, y: 0 }, P { x: 2, y: 0 }) - 1
}
