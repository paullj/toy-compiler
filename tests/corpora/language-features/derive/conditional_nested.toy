# Feature: nested conditional conformance — `Box[Box[Point]]` conforms to `Ord`
# (`Box[T]` iff `T`, recursively down to `Point`'s `int` fields). The `conforms` query is
# memoized by the interned App index so the nested lookup is not re-queried exponentially,
# and the multi-level reify + synthesis is deterministic.
struct Box[T] { v: T }
struct Point { x: int, y: int }

fn main() -> int {
    a := Box[Box[Point]]{ v: Box[Point]{ v: Point{ x: 1, y: 0 } } }
    b := Box[Box[Point]]{ v: Box[Point]{ v: Point{ x: 1, y: 9 } } }
    return if a < b { 42 } else { 0 }
}
# expect: exit 42
