# Feature: generic `mut` parameters: swap[T] at int, str and a struct; a static generic-impl method with a `mut` first param; a generic method with a `mut` non-self param
# expect: exit 63
# swap(a, b) gives a=2, b=1 (inferred); swap[str] moves "abc" into y and "" into x;
# swap of two P values gives p.x=5, q.x=7. Box[int].reset(bx, 9) is static, so `b` is a
# place param, not a receiver: bx.v becomes 9. bx.put(out) copies bx.v into the caller's
# `out`: 9. 20 + 1 + 3 + 0 + 5 + 9 + 18 + 7 = 63.
struct P { x: int }
struct Box[T] { v: T }

impl Box[T] {
    fn reset(mut b: Box[T], v: T) { b.v = v }
    fn put(self, mut out: T) { out = self.v }
}

fn swap[T](mut a: T, mut b: T) {
    t := a
    a = b
    b = t
}

fn main() -> int {
    a := 1
    b := 2
    swap(a, b)
    x := "abc"
    y := ""
    swap[str](x, y)
    p := P { x: 7 }
    q := P { x: 5 }
    swap(p, q)
    bx := Box[int] { v: 0 }
    Box[int].reset(bx, 9)
    out := 0
    bx.put(out)
    return a * 10 + b + y.len() + x.len() + p.x + bx.v + out * 2 + q.x
}
