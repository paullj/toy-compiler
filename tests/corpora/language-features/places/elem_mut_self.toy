# Feature: a `mut self` method called on a Vec element, or on a field chain rooted at one,
# copies the element in before the args and writes it back after the call, then writes
# back each element `mut` arg in order: in a loop, inside a lambda that captures the Vec,
# and with an element arg.
# expect: stdout "2\n14\n6\n17\n15\n2\n"
# expect: exit 0
import std/io
import std/vec

struct C { n: int }

impl C {
    fn bump(mut self) { self.n += 1 }
    fn add(mut self, mut by: int) {
        self.n += by
        by += 1
    }
}

struct H { c: C }

fn main() -> int {
    cs: Vec[C] = [C { n: 0 }, C { n: 10 }]
    for _k in 0..3 { cs[1].bump() }
    i := 0
    while i < 2 {
        cs[i].bump()
        i += 1
    }
    inc := fn(j: int) { cs[j].bump() }
    inc(0)
    hs: Vec[H] = [H { c: C { n: 5 } }]
    hs[0].c.bump()
    io.println(cs[0].n)
    io.println(cs[1].n)
    io.println(hs[0].c.n)

    b := 1
    cs[0].add(b)
    cs[0].add(cs[1].n)
    io.println(cs[0].n)
    io.println(cs[1].n)
    io.println(b)
    return 0
}
