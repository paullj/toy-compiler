# Feature: at -O1 a load after a call that takes the local's address as a `mut` argument reads the callee's write, not a forwarded stale value
# expect: exit 34
# c: 1, then bump(c) makes it 2. p.x: 10, bump(p.x) makes it 11, and the later field read
# must see 11; p.y is untouched (20). set(q) writes the whole struct: q.x is 1.
# 2 + 11 + 20 + 1 = 34.
struct P { x: int, y: int }

fn bump(mut n: int) { n = n + 1 }

fn set(mut q: P) { q = P { x: 1, y: 1 } }

fn main() -> int {
    c := 1
    bump(c)
    p := P { x: 10, y: 20 }
    before := p.x
    bump(p.x)
    q := P { x: 5, y: 5 }
    set(q)
    return c + p.x + p.y + q.x + before - 10
}
