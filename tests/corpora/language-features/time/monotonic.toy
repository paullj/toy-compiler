# Feature: `time.now()` reads a monotonic clock, so 1000 reads in a row never go back.
# expect: stdout "ok\n"
# expect: exit 0
import std/io
import std/time
fn main() -> int {
    prev := time.now()
    for _ in 0..1000 {
        t := time.now()
        if t < prev { return 1 }
        if t.since(prev).ns() < 0 { return 2 }
        prev = t
    }
    io.println("ok")
    return 0
}
