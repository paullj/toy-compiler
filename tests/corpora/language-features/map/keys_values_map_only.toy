# Feature: `keys()` and `values()` come with std/map alone. std/map imports std/vec, so the
# methods of the returned `Vec`s need no import of their own.
# expect: exit 42
import std/map

fn main() -> int {
    m := Map[str, int].new()
    m.set("b", 20)
    m.set("a", 1)
    m.set("b", 21)
    ks := m.keys()
    if ks.len() != 2 || ks.first().or("") != "b" { return 1 }
    if ks.get(1).or("") != "a" { return 2 }
    return m.values().fold(20, fn(acc, v) { acc + v })
}
