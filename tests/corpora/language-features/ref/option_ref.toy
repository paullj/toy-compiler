# expect: exit 42
# Feature: absence over a managed box is `Option[Ref[T]]` (there is no nil). A `Ref[int]`
# is an 8-byte scalar cell pointer, so it rides the scalar Option path (some/none/is_some/
# unwrap). Present: unwrap the handle and deref it (40). Absent: default to 2. 40+2 == 42.
fn pick(present: bool) -> Option[Ref[int]] {
    if present {
        return Option.some(&40)
    }
    return Option[Ref[int]].none
}

fn main() -> int {
    a := pick(true)
    base := if a.is_some() { *a.unwrap() } else { 0 }   # 40
    b := pick(false)
    extra := if b.is_some() { 0 } else { 2 }            # 2
    return base + extra
}
