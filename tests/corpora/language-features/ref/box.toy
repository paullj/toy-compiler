# expect: exit 42
# Feature: a managed heap box `Ref[T]`. `Ref.new(x)` boxes `x` into a fresh cell (an 8-byte
# handle); `r.get()` reads it; `r.set(v)` stores it. `:=` shares the handle (same cell), so
# a write through one handle is observed through the other.
import std/ref

fn main() -> int {
    r := Ref.new(41)    # box: gc_alloc(size_of(int)), copy 41 in, yield Ref[int]
    r.set(r.get() + 1)  # read + store through the box
    s := r              # := shares the handle (same cell)
    s.set(s.get() + 0)
    return r.get()      # 42, observed through the aliased handle
}
