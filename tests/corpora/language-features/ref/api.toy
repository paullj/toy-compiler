# expect: exit 42
# Feature: the `std/ref` API. `Ref.new(v)` boxes `v` (inferring `T`), `r.get()` reads the
# cell and `r.set(v)` writes it. Every copy of a handle names one cell, so a write through
# a copy is seen through the original, and `==` compares cells. A `Vec[Ref[int]]` keeps
# its cells across forced collections, a struct payload round-trips whole, and a
# `Ref[Ref[int]]` reaches the inner cell through `rr.get()`.
import std/ref
import std/vec
import core/mem_selftest

struct P { x: int, y: int }

fn main() -> int {
    r := Ref.new(41)
    r.set(r.get() + 1)
    s := r
    s.set(s.get() + 0)
    if r != s { return 1 }
    if Ref.new(1) == Ref.new(1) { return 2 }
    xs := Vec[Ref[int]].new()
    i := 0
    while i < 50 {
        xs.push(Ref.new(i))
        i = i + 1
    }
    n := mem_selftest.churn_collects()
    if n < 1 { return 3 }
    t := 0
    for c in xs { t = t + c.get() }
    if t != 1225 { return 4 }
    p := Ref.new(P { x: 1, y: 2 })
    q := p
    q.set(P { x: 5, y: 6 })
    if mem_selftest.aggregate_survivor() != 7 { return 5 }
    rr := Ref.new(Ref.new(3))
    inner := rr.get()
    rr.get().set(10)
    if inner.get() != 10 { return 6 }
    return r.get() + p.get().x - 5
}
