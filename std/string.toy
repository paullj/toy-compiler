import core/string

# A growable, packed, reference-semantic String over core/string's byte buffer. The sole
# field `h` is the 8-byte handle, so `s2 := s` shares the same buffer. `std` calls core's
# safe members but never names a heap intrinsic.
pub struct String { h: gc_array[int] }

impl String {
    fn new() -> String {
        return String { h: string.str_new(1) }
    }

    fn len(self) -> int {
        return string.str_len(self.h)
    }

    fn byte_at(self, i: int) -> int {
        return string.str_byte_at(self.h, i)
    }

    fn push_byte(self, byte: int) {
        string.str_push_byte(self.h, byte)
    }
}
