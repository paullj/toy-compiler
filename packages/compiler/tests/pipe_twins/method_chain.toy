# Hand-desugared twin of tests/corpora/language-features/pipe/method_chain.toy.
struct C { n: int }

impl C {
    fn add(self, k: int) -> C { C { n: self.n + k } }
    fn half(self) -> int { self.n / 2 }
}

fn wrap(n: int) -> C { C { n: n } }
fn twice(c: C) -> C { C { n: c.n * 2 } }

fn main() -> int {
    c := C { n: 1 }
    a := c.add(2).add(3).half()
    b := twice(wrap(4).add(1)).half()
    d := twice(c.add(9)).half()
    return a + b + d
}
