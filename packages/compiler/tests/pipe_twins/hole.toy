# Hand-desugared twin of tests/corpora/language-features/pipe/hole.toy.
struct Acc { n: int }

impl Acc {
    fn plus(self, k: int) -> int { self.n + k }
}

fn add(a: int, b: int) -> int { return a + b }
fn sub(a: int, b: int) -> int { return a - b }
fn mul(a: int, b: int) -> int { return a * b }
fn apply(x: int, f: fn(int) -> int) -> int { return f(x) }

fn main() -> int {
    a := add(1, 3)
    b := sub(10, 3)
    c := sub(3, 1)
    acc := Acc { n: 20 }
    d := acc.plus(1)
    e := apply(4, fn(v) { add(5, v) })
    f := mul(2, add(1, 2))
    return a + b + c + d + e + f
}
