# Hand-desugared twin of tests/corpora/language-features/pipe/eval_order.toy.
import std/io

fn tag(s: str, v: int) -> int {
    io.println(s)
    return v
}

fn add(a: int, b: int) -> int { return a + b }
fn add3(a: int, b: int, c: int) -> int { return a + b + c }

fn main() -> int {
    return add3(add(tag("a", 1), tag("b", 2)), tag("c", 3), tag("d", 4))
}
