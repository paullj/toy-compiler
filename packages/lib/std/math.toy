import core/ffi

# Integer helpers (pure — no FFI). `abs` reaches C `labs` through `core/ffi`'s safe
# wrapper; the rest are ordinary integer arithmetic.
pub fn abs(x: int) -> int {
    return ffi.abs(x)
}

pub fn min(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

pub fn max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

pub fn clamp(x: int, lo: int, hi: int) -> int {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

pub fn sign(x: int) -> int {
    if x > 0 {
        return 1
    }
    if x < 0 {
        return -1
    }
    return 0
}

# `base` raised to a non-negative `exp` by repeated multiplication.
pub fn pow(base: int, exp: int) -> int {
    r := 1
    i := 0
    while i < exp {
        r = r * base
        i = i + 1
    }
    return r
}

# Floating-point ops over libm, reached through `core/ffi`'s safe wrappers.
pub fn sqrt(x: float) -> float {
    return ffi.msqrt(x)
}

pub fn floor(x: float) -> float {
    return ffi.mfloor(x)
}

pub fn ceil(x: float) -> float {
    return ffi.mceil(x)
}

pub fn sin(x: float) -> float {
    return ffi.msin(x)
}

pub fn cos(x: float) -> float {
    return ffi.mcos(x)
}
