# The closure methods of the prelude `Option` and `Result`. Every method is generic, so
# only the instances a program calls are emitted. `or_else` is the lazy `or`: its
# function runs only when there is no value. The methods exist when the program imports
# `std/option`, as `Ref`'s exist with `std/ref`.

impl Option[T] {
    fn map[U](self, f: fn(T) -> U) -> Option[U] {
        match self {
            .some(v) -> Option.some(f(v)),
            .none -> Option[U].none,
        }
    }

    fn then[U](self, f: fn(T) -> Option[U]) -> Option[U] {
        match self {
            .some(v) -> f(v),
            .none -> Option[U].none,
        }
    }

    fn or_else(self, f: fn() -> T) -> T {
        match self {
            .some(v) -> v,
            .none -> f(),
        }
    }
}

impl Result[T, E] {
    fn map[U](self, f: fn(T) -> U) -> Result[U, E] {
        match self {
            .ok(v) -> Result.ok(f(v)),
            .err(e) -> Result.err(e),
        }
    }

    fn then[U](self, f: fn(T) -> Result[U, E]) -> Result[U, E] {
        match self {
            .ok(v) -> f(v),
            .err(e) -> Result.err(e),
        }
    }

    fn map_error[F](self, f: fn(E) -> F) -> Result[T, F] {
        match self {
            .ok(v) -> Result.ok(v),
            .err(e) -> Result.err(f(e)),
        }
    }

    fn or_else(self, f: fn(E) -> T) -> T {
        match self {
            .ok(v) -> v,
            .err(e) -> f(e),
        }
    }
}
