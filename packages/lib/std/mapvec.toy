# `keys()` and `values()` on `Map`, each a new `Vec` in insertion order. They live here, not
# in std/map, so that a program importing std/map alone keeps `Vec` out of its graph: a new
# struct in a graph renumbers the reified struct ids its binary embeds.
import core/mem
import std/map
import std/vec

impl Map[K has Hashable, V] {
    fn keys(self) -> Vec[K] {
        n := mem.mp_len[K, V](self.h)
        out := Vec[K].new()
        i := 0
        while i < n {
            out.push(mem.mp_key_at[K, V](self.h, i))
            i = i + 1
        }
        return out
    }

    fn values(self) -> Vec[V] {
        n := mem.mp_len[K, V](self.h)
        out := Vec[V].new()
        i := 0
        while i < n {
            out.push(mem.mp_val_at[K, V](self.h, i))
            i = i + 1
        }
        return out
    }
}
