import core/sys

# `print` renders any Display value to a str then writes it. `to_string(str)` is identity
# (no alloc), so a str arg keeps the alloc-free path; every other kind renders through the
# universal `to_string`/`display` authority.
pub fn print[T has Display](x: T) {
    sys.print(x.to_string())
}

# The newline is a second `sys.print` (not string concat) so the alloc-free str path holds.
pub fn println[T has Display](x: T) {
    sys.print(x.to_string())
    sys.print("\n")
}
