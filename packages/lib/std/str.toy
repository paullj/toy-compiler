# Methods on the prelude `str`. Positions are byte offsets, and a substring (from `split` or
# `trim`) shares its parent's bytes. The search is a simple byte-wise scan, not a tuned one;
# on valid UTF-8 it never matches inside a char. The methods exist when the program imports
# `std/str`, as `Ref`'s exist with `std/ref`.
import core/text
import std/vec
import std/iter

impl str {
    fn contains(self, sub: str) -> bool {
        return find_from(self, sub, 0) >= 0
    }

    fn starts_with(self, p: str) -> bool {
        return matches_at(self, p, 0)
    }

    fn ends_with(self, p: str) -> bool {
        return matches_at(self, p, self.len() - p.len())
    }

    # ASCII whitespace only (space, \t, \n, \v, \f, \r): no Unicode tables.
    fn trim(self) -> str {
        lo := 0
        hi := self.len()
        while lo < hi && is_space(self.byte_at(lo)) { lo += 1 }
        while hi > lo && is_space(self.byte_at(hi - 1)) { hi -= 1 }
        return text.slice(self, lo, hi)
    }

    # The parts between each `sep`, in order, empty ones kept; an empty `sep` gives the
    # whole string.
    fn split(self, sep: str) -> Vec[str] {
        out := Vec[str].new()
        if sep.len() == 0 {
            out.push(self)
            return out
        }
        start := 0
        loop {
            at := find_from(self, sep, start)
            if at < 0 { break }
            out.push(text.slice(self, start, at))
            start = at + sep.len()
        }
        out.push(text.slice(self, start, self.len()))
        return out
    }

    # The length is summed first and the bytes copied once, so a join of many parts stays
    # linear; concatenating part by part would copy the growing prefix every time.
    fn join(self, parts: Vec[str]) -> str {
        n := parts.len()
        if n == 0 { return "" }
        total := self.len() * (n - 1)
        i := 0
        while i < n {
            total += parts.get(i).or("").len()
            i += 1
        }
        buf := text.alloc(total)
        at := 0
        i = 0
        while i < n {
            if i > 0 {
                text.put(buf, at, self)
                at += self.len()
            }
            p := parts.get(i).or("")
            text.put(buf, at, p)
            at += p.len()
            i += 1
        }
        return text.take(buf, total)
    }

    # Every `from` replaced by `to`; an empty `from` changes nothing.
    fn replace(self, from: str, to: str) -> str {
        return to.join(self.split(from))
    }

    # A decimal int with an optional `+` or `-`: no spaces, no `_`, at least one digit. The
    # value is accumulated negated because int's range reaches one further below zero than
    # above, so the most negative int parses without overflowing on the way.
    fn parse_int(self) -> Option[int] {
        n := self.len()
        i := 0
        neg := false
        if n > 0 && (self.byte_at(0) == 43 || self.byte_at(0) == 45) {
            neg = self.byte_at(0) == 45
            i = 1
        }
        if i == n { return Option[int].none }
        min := -9223372036854775807 - 1
        acc := 0
        while i < n {
            d := self.byte_at(i) - 48
            if d < 0 || d > 9 { return Option[int].none }
            if acc < min / 10 { return Option[int].none }
            acc *= 10
            if acc < min + d { return Option[int].none }
            acc -= d
            i += 1
        }
        if neg { return Option.some(acc) }
        if acc == min { return Option[int].none }
        return Option.some(-acc)
    }

    fn chars(self) -> Chars[char] {
        return Chars[char] { s: self, i: 0 }
    }
}

# A UTF-8 decoder over a str. `T` is always `char`: `for` iterates generic iterator types only.
pub struct Chars[T] { s: str, i: int }

impl Chars[T] {
    fn iter(self) -> Chars[T] { self }
}

# Malformed input never panics, and every call moves `i` forward, so a walk ends. A lead
# byte C2-DF, E0-EF or F0-F4 takes 1, 2 or 3 continuation bytes (80-BF); any other
# non-ASCII byte is one U+FFFD. A missing or bad continuation yields one U+FFFD and resumes
# AT that byte, which may start the next char. A complete sequence that is overlong (below
# its length's minimum), a surrogate or above U+10FFFF is one U+FFFD.
impl Chars[T] has iter.Iterator[char] {
    fn next(mut self) -> Option[char] {
        n := self.s.len()
        if self.i >= n { return Option[char].none }
        b0 := self.s.byte_at(self.i)
        if b0 < 128 {
            self.i += 1
            return Option.some(scalar(b0))
        }
        need := 0
        cp := 0
        min := 0
        if b0 >= 194 && b0 <= 223 {
            need = 1
            cp = b0 - 192
            min = 128
        } else if b0 >= 224 && b0 <= 239 {
            need = 2
            cp = b0 - 224
            min = 2048
        } else if b0 >= 240 && b0 <= 244 {
            need = 3
            cp = b0 - 240
            min = 65536
        } else {
            self.i += 1
            return Option.some('\u{FFFD}')
        }
        k := 1
        while k <= need {
            if self.i + k >= n {
                self.i += k
                return Option.some('\u{FFFD}')
            }
            b := self.s.byte_at(self.i + k)
            if b < 128 || b > 191 {
                self.i += k
                return Option.some('\u{FFFD}')
            }
            cp = cp * 64 + (b - 128)
            k += 1
        }
        self.i = self.i + need + 1
        if cp < min { return Option.some('\u{FFFD}') }
        return Option.some(scalar(cp))
    }
}

fn matches_at(s: str, sub: str, i: int) -> bool {
    if i < 0 || i + sub.len() > s.len() { return false }
    j := 0
    while j < sub.len() && s.byte_at(i + j) == sub.byte_at(j) { j += 1 }
    return j == sub.len()
}

fn find_from(s: str, sub: str, from: int) -> int {
    i := from
    while i + sub.len() <= s.len() {
        if matches_at(s, sub, i) { return i }
        i += 1
    }
    return -1
}

fn is_space(b: int) -> bool {
    return b == 32 || (b >= 9 && b <= 13)
}

fn scalar(cp: int) -> char {
    return match cp.try_into() {
        .ok(c) -> c
        .err(_) -> '\u{FFFD}'
    }
}
