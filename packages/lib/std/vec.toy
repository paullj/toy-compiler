import core/mem
import std/iter

# A thin, growable `Vec[T]` face over `core/mem`'s `GcArray` primitive. `std` may call
# `core`'s safe members but never names a heap intrinsic itself, so every raw operation is
# delegated to `mem`. The sole field `h` is the 8-byte reference handle, so `ys := xs`
# copies the handle and shares the SAME growable (a push through one is visible through the
# other). `new` is an ASSOCIATED function (no `self`), called as `Vec[int].new()`; `[]`
# desugars to the same constructor.
pub struct Vec[T] { h: gc_array[T] }

impl Vec[T] {
    fn new() -> Vec[T] {
        return Vec[T] { h: mem.ga_new[T]() }
    }

    fn push(self, x: T) {
        mem.ga_push[T](self.h, x)
    }

    fn len(self) -> int {
        return mem.ga_len[T](self.h)
    }

    fn get(self, i: int) -> Option[T] {
        if 0 <= i && i < mem.ga_len[T](self.h) {
            return Option.some(mem.ga_get[T](self.h, i))
        }
        return Option[T].none
    }

    fn first(self) -> Option[T] {
        return self.get(0)
    }

    fn iter(self) -> VecIter[T] {
        return VecIter[T] { v: self, i: -1 }
    }

    # The walks read the length once, so a callback that pushes cannot extend its own walk.
    fn each(self, f: fn(T)) {
        n := mem.ga_len[T](self.h)
        i := 0
        while i < n {
            f(mem.ga_get[T](self.h, i))
            i += 1
        }
    }

    fn map[U](self, f: fn(T) -> U) -> Vec[U] {
        n := mem.ga_len[T](self.h)
        out := Vec[U].new()
        i := 0
        while i < n {
            out.push(f(mem.ga_get[T](self.h, i)))
            i += 1
        }
        return out
    }

    fn filter(self, f: fn(T) -> bool) -> Vec[T] {
        n := mem.ga_len[T](self.h)
        out := Vec[T].new()
        i := 0
        while i < n {
            x := mem.ga_get[T](self.h, i)
            if f(x) { out.push(x) }
            i += 1
        }
        return out
    }

    fn fold[A](self, init: A, f: fn(A, T) -> A) -> A {
        n := mem.ga_len[T](self.h)
        acc := init
        i := 0
        while i < n {
            acc = f(acc, mem.ga_get[T](self.h, i))
            i += 1
        }
        return acc
    }

    fn any(self, f: fn(T) -> bool) -> bool {
        n := mem.ga_len[T](self.h)
        i := 0
        while i < n {
            if f(mem.ga_get[T](self.h, i)) { return true }
            i += 1
        }
        return false
    }

    fn all(self, f: fn(T) -> bool) -> bool {
        n := mem.ga_len[T](self.h)
        i := 0
        while i < n {
            if !f(mem.ga_get[T](self.h, i)) { return false }
            i += 1
        }
        return true
    }

    fn find(self, f: fn(T) -> bool) -> Option[T] {
        n := mem.ga_len[T](self.h)
        i := 0
        while i < n {
            x := mem.ga_get[T](self.h, i)
            if f(x) { return Option.some(x) }
            i += 1
        }
        return Option[T].none
    }

    # Stable: the right run's element goes first only when `less(right, left)`.
    fn sort_by(self, less: fn(T, T) -> bool) {
        n := mem.ga_len[T](self.h)
        src := self.h
        dst := mem.ga_new[T]()
        i := 0
        while i < n {
            mem.ga_push[T](dst, mem.ga_get[T](src, i))
            i += 1
        }
        width := 1
        flipped := false
        while width < n {
            lo := 0
            while lo < n {
                mid := if lo + width < n { lo + width } else { n }
                hi := if lo + 2 * width < n { lo + 2 * width } else { n }
                l := lo
                r := mid
                k := lo
                while k < hi {
                    if r < hi && (l >= mid || less(mem.ga_get[T](src, r), mem.ga_get[T](src, l))) {
                        mem.ga_set[T](dst, k, mem.ga_get[T](src, r))
                        r += 1
                    } else {
                        mem.ga_set[T](dst, k, mem.ga_get[T](src, l))
                        l += 1
                    }
                    k += 1
                }
                lo = hi
            }
            t := src
            src = dst
            dst = t
            flipped = !flipped
            width *= 2
        }
        if flipped {
            i = 0
            while i < n {
                mem.ga_set[T](self.h, i, mem.ga_get[T](src, i))
                i += 1
            }
        }
    }
}

impl Vec[T has Ord] {
    fn sort(self) {
        self.sort_by(fn(a: T, b: T) { a < b })
    }
}

# A by-value cursor over a `Vec[T]`. `v` copies the 8-byte handle `h`, so it observes the
# SAME live backing (reference-semantic); `i` starts at -1 so the first `next` reads index
# 0 and `get` returns `Option[T].none` once `i >= len`, ending the loop. `mut self` writes
# `i` back across iterations.
pub struct VecIter[T] { v: Vec[T], i: int }

impl VecIter[T] has iter.Iterator[T] {
    fn next(mut self) -> Option[T] {
        self.i += 1
        return self.v.get(self.i)
    }
}
