# Raw `str` parts for std/str. A str is a `{ptr, len}` pair, so a substring is a new pair
# into its parent's bytes: no copy. A str built from parts is written into one buffer of
# its final length, so building it copies each byte once.

# The bytes [lo, hi) of `s` as a str that shares its buffer: the collector keeps the parent's
# cell alive through the interior pointer. The cell is allocated before the parent's address
# is read into an int, so no heap address lives only in an int across an allocation. The
# caller keeps `0 <= lo <= hi <= s.len()`.
pub fn slice(s: str, lo: int, hi: int) -> str {
    if hi <= lo { return "" }
    cell := gc_alloc(16)
    unsafe {
        store(cell, s)
        p: int = load(cell)
        store(cell, p + lo)
        store(offset(cell, 8), hi - lo)
    }
    r: str = unsafe { load(cell) }
    return r
}

# A buffer of `n` bytes for a str under construction. A `rawptr` is a root, so the buffer
# lives while the builder holds it.
pub fn alloc(n: int) -> rawptr {
    return gc_alloc(n)
}

# Copy the bytes of `s` into `buf` from byte `at`; the caller keeps `at + s.len()` within
# `buf`.
pub fn put(buf: rawptr, at: int, s: str) {
    n := s.len()
    i := 0
    while i < n {
        unsafe { store_byte(offset(buf, at + i), s.byte_at(i)) }
        i = i + 1
    }
}

# The first `n` bytes of `buf` as a str. The str points at `buf`, which the collector then
# keeps alive through it.
pub fn take(buf: rawptr, n: int) -> str {
    if n == 0 { return "" }
    cell := gc_alloc(16)
    unsafe {
        store(cell, buf)
        store(offset(cell, 8), n)
    }
    r: str = unsafe { load(cell) }
    return r
}
