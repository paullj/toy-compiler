{
  "grammars": [
    {
      "name": "toy",
      "camelcase": "Toy",
      "scope": "source.toy",
      "path": ".",
      "file-types": ["toy"],
      "highlights": ["queries/highlights.scm"]
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT",
    "description": "Tree-sitter grammar for the toy language",
    "authors": [{ "name": "toy-compiler" }]
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
