# Size-class policy for the span arena. Pure and heap-free: it names no allocator
# intrinsic, it only rounds a byte request up to the nearest size class. Requests
# above the largest class fall through to `gc_alloc`'s direct large-object mmap.
pub fn size_class_of(n: int) -> int {
    if n <= 16 { return 16 }
    if n <= 32 { return 32 }
    if n <= 48 { return 48 }
    if n <= 64 { return 64 }
    if n <= 96 { return 96 }
    if n <= 128 { return 128 }
    if n <= 192 { return 192 }
    if n <= 256 { return 256 }
    if n <= 512 { return 512 }
    if n <= 1024 { return 1024 }
    if n <= 2048 { return 2048 }
    if n <= 4096 { return 4096 }
    if n <= 8192 { return 8192 }
    return n
}

# A growable, traced array primitive: the ONE growable container. The handle is an
# 8-byte reference (`gc_array[T]`, a reused native box) pointing at a heap header
# `{len@0, cap@8, elems@16}` — a raw 24-byte cell addressed by literal offsets. The
# element backing lives at `elems`, each element at `elems + i*size_of[T]()`. `:=` copies
# the handle, so two bindings share the same growable (mutation through one is seen
# through the other). There is no collector: `ga_grow` leaks the old backing.

# Construct an empty array with a small initial backing. `len` is born 0 (cells are
# zeroed on alloc); `cap` starts at 4.
pub fn ga_new[T]() -> gc_array[T] {
    hdr := gc_alloc(24)
    unsafe {
        store(offset(hdr, 8), 4)
        store(offset(hdr, 16), gc_alloc(4 * size_of[T]()))
    }
    return gc_array[T](hdr)
}

pub fn ga_len[T](a: gc_array[T]) -> int {
    return unsafe { load(offset(a, 0)) }
}

pub fn ga_get[T](a: gc_array[T], i: int) -> T {
    e := unsafe { load(offset(a, 16)) }
    return unsafe { load(offset(e, i * size_of[T]())) }
}

# Bounds-checked read: the sole element-access contract `xs[i]` desugars to, so the
# header offsets and element stride live only here. A signed `i < 0 || i >= len` catches
# both a negative index and an over-length one before the unchecked `ga_get` read.
pub fn ga_at[T](a: gc_array[T], i: int) -> T {
    if i < 0 || i >= ga_len[T](a) {
        panic("index out of bounds")
    }
    return ga_get[T](a, i)
}

pub fn ga_push[T](a: gc_array[T], x: T) {
    l := unsafe { load(offset(a, 0)) }
    c := unsafe { load(offset(a, 8)) }
    if l == c { ga_grow[T](a, c) }
    e := unsafe { load(offset(a, 16)) }
    unsafe {
        store(offset(e, l * size_of[T]()), x)
        store(offset(a, 0), l + 1)
    }
}

# Double the backing and copy the live prefix over. The OLD backing just leaks (no
# collector). The header never moves, so every alias sees the new backing.
pub fn ga_grow[T](a: gc_array[T], c: int) {
    nc := c * 2
    ne := gc_alloc(nc * size_of[T]())
    e := unsafe { load(offset(a, 16)) }
    i := 0
    while i < c {
        v: T = unsafe { load(offset(e, i * size_of[T]())) }
        unsafe { store(offset(ne, i * size_of[T]()), v) }
        i = i + 1
    }
    unsafe {
        store(offset(a, 16), ne)
        store(offset(a, 8), nc)
    }
}
