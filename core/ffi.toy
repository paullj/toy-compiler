# The quarantined C-ABI boundary. `extern` declarations are only legal here (in a
# `core/` module); everything else reaches C through a safe wrapper.
pub extern fn labs(x: int) -> int

# `std` reaches C `labs` through this safe `abs`: the extern name resolves only inside
# `core/`, so a std/user module calls this wrapper, never the raw extern.
pub fn abs(x: int) -> int {
    return labs(x)
}
