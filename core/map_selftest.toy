import core/mem

# A `core/` module, so it may force a collection. Builds a Map through the raw erased table
# with 8 keys that all share a start bucket (k & 7 == 1) to force long probe chains AND a
# grow (the 6th insert), forces one collection, then re-reads every entry: the conservative
# object scan must keep the header, buckets, and entries arrays — hence every live entry —
# alive across the collect. 0 == every invariant held.
pub fn collision_survives() -> int {
    m := mem.mp_new[int, int]()
    i := 0
    loop {
        if i >= 8 { break }
        k := 1 + i * 8
        mem.mp_set[int, int](m, k, k * 100)
        i = i + 1
    }
    gc_collect()
    i = 0
    loop {
        if i >= 8 { break }
        k := 1 + i * 8
        idx := mem.mp_find[int, int](m, k)
        if idx < 0 { return 1 }
        if mem.mp_val_at[int, int](m, idx) != k * 100 { return 2 }
        i = i + 1
    }
    if mem.mp_len[int, int](m) != 8 { return 3 }
    return 0
}
